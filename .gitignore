# Android SDK and Gradle (mobile app build artifacts - DO NOT COMMIT)
android-sdk/
.gradle/
.android/
mobile-app/android/
mobile-app/.gradle/
mobile-app/node_modules/

# Generated sudoers files (regenerated by update.sh with correct paths)
deploy/*-sudoers
# ...except these three, which are shipped templates rather than generated
# output. v3.17.516: without these negations the v3.17.492 rename's replacement
# for clientst0r-mobile-build-sudoers could not be added at all — git ignored
# it silently — so `deploy/setup_mobile_build.sh` had nothing to copy and every
# update since logged "[WARN] Mobile build setup failed".
!deploy/clientst0r-fail2ban-sudoers
!deploy/clientst0r-install-sudoers
!deploy/clientst0r-mobile-build-sudoers

# Local-only side projects (not part of clientst0r)
projects/

# Android app — separate stack, in its own repo or unpublished
clientst0r-android/

# Mobile app — scrubbed from GitHub history 2026-05-14; kept on-disk only.
# Do not commit; do not re-track. Includes the Expo TypeScript app,
# its build tooling (android/, gradle, EAS, patches/), and the older
# mobile-app/ directory.
mobile/
mobile-app/
_mobile_backup_*.tar.gz
