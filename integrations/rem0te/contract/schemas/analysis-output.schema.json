{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "maxLength": 1500
    },
    "facts": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence_refs": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "required": [
          "statement"
        ]
      }
    },
    "hypotheses": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_refs": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "required": [
          "statement",
          "confidence"
        ]
      }
    },
    "draft_reply": {
      "default": "",
      "type": "string",
      "maxLength": 6000
    },
    "next_steps": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    }
  },
  "required": [
    "category",
    "summary"
  ],
  "$id": "urn:rem0te:contract:ticket-rmm-v1:analysis-output",
  "title": "ticket-rmm-v1 analysis-output"
}
