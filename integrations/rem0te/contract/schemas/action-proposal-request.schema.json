{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ticket-rmm-v1"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@-]+$"
    },
    "technician_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@-]+$"
    },
    "rem0te_endpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+$"
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9.]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 200
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "origin": {
      "type": "string",
      "enum": [
        "ai_suggestion",
        "technician"
      ]
    },
    "ticket_ref": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:#/-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "starts_in_minutes": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "window_hours": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    }
  },
  "required": [
    "contract",
    "idempotency_key",
    "organization_id",
    "technician_id",
    "rem0te_endpoint_id",
    "action",
    "params",
    "reason",
    "origin"
  ],
  "additionalProperties": false,
  "$id": "urn:rem0te:contract:ticket-rmm-v1:action-proposal-request",
  "title": "ticket-rmm-v1 action-proposal-request"
}
