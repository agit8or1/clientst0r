{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ticket-rmm-v1"
    },
    "idempotency_key": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_approval",
        "approved",
        "rejected",
        "canceled",
        "expired",
        "dispatched",
        "succeeded",
        "failed",
        "refused_by_endpoint",
        "not_executed",
        "unknown"
      ]
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "rem0te_endpoint_id": {
      "type": "string"
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "string",
      "enum": [
        "ai_suggestion",
        "technician"
      ]
    },
    "ticket_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    },
    "approvals_required": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "customer_signoff": {
      "type": "boolean"
    },
    "approval_url": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "window": {
      "type": "object",
      "properties": {
        "not_before": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "not_after": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "not_before",
        "not_after"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "succeeded",
            "already_running",
            "failed",
            "refused",
            "not_executed",
            "uncertain"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "observed": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "contract",
    "idempotency_key",
    "job_id",
    "status",
    "status_reason",
    "rem0te_endpoint_id",
    "action",
    "origin",
    "ticket_ref",
    "risk",
    "approvals_required",
    "customer_signoff",
    "approval_url",
    "plan_digest",
    "window",
    "outcome",
    "observed",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$id": "urn:rem0te:contract:ticket-rmm-v1:action-proposal",
  "title": "ticket-rmm-v1 action-proposal"
}
