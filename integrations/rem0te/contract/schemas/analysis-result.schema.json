{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "visibility": {
      "type": "string",
      "const": "staff_only"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "model_cited",
              "rem0te_observed"
            ]
          }
        },
        "required": [
          "statement",
          "evidence_refs",
          "model_profiles",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "statement",
          "evidence_refs",
          "model_profiles",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "statement",
          "evidence_refs",
          "model_profiles",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "draft_replies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_profile": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "const": "staff_only"
          },
          "requires_human_review": {
            "type": "boolean",
            "const": true
          },
          "link_hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "model_profile",
          "text",
          "visibility",
          "requires_human_review",
          "link_hosts"
        ],
        "additionalProperties": false
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "model_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "executable": {
            "type": "boolean",
            "const": false
          },
          "requires_human_approval": {
            "type": "boolean",
            "const": true
          },
          "blocked_category": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "model_profiles",
          "executable",
          "requires_human_approval",
          "blocked_category"
        ],
        "additionalProperties": false
      }
    },
    "per_model": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_profile": {
            "type": "string"
          },
          "resolved_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "dropped_unknown_fields": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "usage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "input_tokens",
                  "output_tokens"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model_profile",
          "resolved_model",
          "status",
          "category",
          "summary",
          "dropped_unknown_fields",
          "usage"
        ],
        "additionalProperties": false
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "category",
              "hypothesis"
            ]
          },
          "detail": {
            "type": "string"
          },
          "model_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "detail",
          "model_profiles"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ref",
          "kind",
          "summary",
          "observed_at"
        ],
        "additionalProperties": false
      }
    },
    "untrusted_input_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "pattern"
        ],
        "additionalProperties": false
      }
    },
    "partial_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_profile": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "model_profile",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "visibility",
    "facts",
    "hypotheses",
    "unsupported_claims",
    "draft_replies",
    "next_steps",
    "per_model",
    "disagreements",
    "evidence",
    "untrusted_input_flags",
    "partial_failures"
  ],
  "additionalProperties": false,
  "$id": "urn:rem0te:contract:ticket-rmm-v1:analysis-result",
  "title": "ticket-rmm-v1 analysis-result"
}
