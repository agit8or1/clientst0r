{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ticket-rmm-v1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "refused"
      ]
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@-]+$"
    },
    "ticket_url": {
      "type": "string",
      "maxLength": 512,
      "format": "uri"
    },
    "error_code": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "contract",
    "event_id",
    "status"
  ],
  "additionalProperties": false,
  "$id": "urn:rem0te:contract:ticket-rmm-v1:proposed:ticket-create-request-response",
  "title": "ticket-rmm-v1 PROPOSED ticket-create-request-response (revision 4 proposal, not agreed)"
}
