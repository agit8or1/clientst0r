# Re-applies the editor's egress rules (nftables table inet clientst0r_office)
# at boot, before Docker starts the editor container again, or before
# coolwsd.service starts (native runtime: rules for the "cool" user).
[Unit]
Description=clientst0r Office editor firewall
Before=docker.service coolwsd.service
After=nftables.service
ConditionPathExists=/etc/clientst0r/office-service.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/clientst0r-office-helper cli apply-firewall

[Install]
WantedBy=multi-user.target
