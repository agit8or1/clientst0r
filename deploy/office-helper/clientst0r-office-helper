def _meminfo():
    out = {}
    try:
        with open(P('/proc/meminfo') if TEST_MODE and os.path.exists(P('/proc/meminfo'))
                  else '/proc/meminfo', encoding='ascii') as f:
            for line in f:
                key, _, rest = line.partition(':')
                out[key.strip()] = int(rest.split()[0]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return out


def _cpu_count():
    if TEST_MODE and os.environ.get('CLIENTST0R_OFFICE_HELPER_TEST_CPUS'):
        return int(os.environ['CLIENTST0R_OFFICE_HELPER_TEST_CPUS'])
    return os.cpu_count() or 1


def load_config():
    path = P(CONF_PATH)
    _check_trusted(path)
    raw = {}
    with open(path, encoding='utf-8') as f:
        for n, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if '=' not in line:
                raise HelperError(f'{CONF_PATH}:{n}: expected KEY=VALUE')
            key, value = line.split('=', 1)
            raw[key.strip()] = value.strip()
    return validate_config(raw)


KNOWN_KEYS = {'DEPLOYMENT_ID', 'APP_USER', 'OFFICE_HOSTNAME', 'CLIENTSTOR_URL', 'BIND_PORT',
              'EDITION', 'CPUS', 'MEMORY_MB', 'RESERVE_MB', 'NETWORK_SUBNET',
              'ALLOW_UNTESTED_RELEASES', 'PRIVATE_CA', 'MAINTENANCE_UPDATES'}


def validate_config(raw):
    unknown = sorted(set(raw) - KNOWN_KEYS)
    if unknown:
        raise HelperError(f'{CONF_PATH}: unknown setting(s) {", ".join(unknown)}')
    c = {}

    def need(key, pattern, label):
        value = raw.get(key, '')
        if not pattern.match(value):
            raise HelperError(f'{CONF_PATH}: {key} is missing or not {label}')
        return value

    c['deployment_id'] = need('DEPLOYMENT_ID', ID_RE, 'a short lower-case id')
    c['app_user'] = need('APP_USER', USER_RE, 'a user name')
    if c['app_user'] == 'root':
        raise HelperError(f'{CONF_PATH}: APP_USER must not be root')
    c['office_hostname'] = need('OFFICE_HOSTNAME', HOST_RE, 'a DNS host name').lower()

    url = raw.get('CLIENTSTOR_URL', '')
    m = re.match(r'^https://([a-z0-9.-]+)(:([0-9]{2,5}))?/?$', url.lower())
    if not m or not HOST_RE.match(m.group(1)):
        raise HelperError(f'{CONF_PATH}: CLIENTSTOR_URL must be https://<clientst0r host name>/ '
                          '(no path, no IP address)')
    c['clientstor_host'] = m.group(1)
    c['clientstor_port'] = int(m.group(3) or 443)
    if c['clientstor_port'] != 443:
        # The firewall opens exactly gateway:443 to the container.
        raise HelperError(f'{CONF_PATH}: CLIENTSTOR_URL must use port 443')
    c['clientstor_url'] = f'https://{c["clientstor_host"]}/'
    if c['clientstor_host'] == c['office_hostname']:
        raise HelperError(f'{CONF_PATH}: OFFICE_HOSTNAME must differ from clientst0r\'s host name '
                          '(the editor gets its own origin)')

    try:
        c['bind_port'] = int(raw.get('BIND_PORT', '8090'))
    except ValueError:
        raise HelperError(f'{CONF_PATH}: BIND_PORT must be a number')
    if not 1024 <= c['bind_port'] <= 65535:
        raise HelperError(f'{CONF_PATH}: BIND_PORT must be 1024-65535')

    c['edition'] = raw.get('EDITION', 'community')
    if c['edition'] not in ('community', 'enterprise'):
        raise HelperError(f'{CONF_PATH}: EDITION must be community or enterprise')

    try:
        c['reserve_mb'] = int(raw.get('RESERVE_MB', str(DEFAULT_RESERVE_MB)))
        c['memory_mb'] = int(raw.get('MEMORY_MB', str(VENDOR_RECOMMENDED_MEMORY_MB)))
        c['cpus'] = float(raw.get('CPUS', '2'))
    except ValueError:
        raise HelperError(f'{CONF_PATH}: CPUS, MEMORY_MB and RESERVE_MB must be numbers')
    if c['reserve_mb'] < 1024:
        raise HelperError(f'{CONF_PATH}: RESERVE_MB must leave at least 1024 MB for clientst0r')
    if c['memory_mb'] < VENDOR_MIN_MEMORY_MB:
        raise HelperError(f'{CONF_PATH}: MEMORY_MB must be at least {VENDOR_MIN_MEMORY_MB} '
                          '(ONLYOFFICE\'s published minimum)')
    total = _meminfo().get('MemTotal', 0)
    if total and c['memory_mb'] + c['reserve_mb'] > total:
        raise HelperError(f'{CONF_PATH}: MEMORY_MB {c["memory_mb"]} + RESERVE_MB {c["reserve_mb"]} '
                          f'is more than this host\'s {total} MB')
    ncpu = _cpu_count()
    if not (0.5 <= c['cpus'] <= max(0.5, ncpu - 1)) or round(c['cpus'], 2) != c['cpus']:
        raise HelperError(f'{CONF_PATH}: CPUS must be 0.5-{max(0.5, ncpu - 1)} (one core stays '
                          'for clientst0r), at most two decimals')

    try:
        net = ipaddress.ip_network(raw.get('NETWORK_SUBNET', '172.31.250.0/28'), strict=True)
    except ValueError:
        raise HelperError(f'{CONF_PATH}: NETWORK_SUBNET is not a network such as 172.31.250.0/28')
    if net.version != 4 or not net.is_private or not 24 <= net.prefixlen <= 29 \
            or net.overlaps(ipaddress.ip_network('169.254.0.0/16')) \
            or net.overlaps(ipaddress.ip_network('127.0.0.0/8')):
        raise HelperError(f'{CONF_PATH}: NETWORK_SUBNET must be a private IPv4 /24-/29')
    c['subnet'] = str(net)
    c['gateway'] = str(next(net.hosts()))

    for key, name in (('ALLOW_UNTESTED_RELEASES', 'allow_untested'), ('PRIVATE_CA', 'private_ca'),
                      ('MAINTENANCE_UPDATES', 'maintenance_updates')):
        value = raw.get(key, 'no')
        if value not in ('yes', 'no'):
            raise HelperError(f'{CONF_PATH}: {key} must be yes or no')
        c[name] = value == 'yes'

    try:
        c['app_uid'] = pwd.getpwnam(c['app_user']).pw_uid
    except KeyError:
        if not TEST_MODE:
            raise HelperError(f'{CONF_PATH}: APP_USER {c["app_user"]} does not exist')
        c['app_uid'] = TEST_UID
    if TEST_MODE:
        c['app_uid'] = TEST_UID
    c['internal_url'] = f'http://127.0.0.1:{c["bind_port"]}/'
    c['browser_url'] = f'https://{c["office_hostname"]}/'
    return c


def public_config(c):
    """What status may show the app: no secrets, no paths."""
    return {k: c[k] for k in ('deployment_id', 'office_hostname', 'clientstor_url', 'browser_url',
                              'internal_url', 'bind_port', 'edition', 'cpus', 'memory_mb',
                              'reserve_mb', 'subnet', 'allow_untested', 'private_ca',
                              'maintenance_updates')}


# ---------------------------------------------------------------------------
# releases
# ---------------------------------------------------------------------------

def release(release_id):
    for r in RELEASES:
        if r['id'] == release_id:
            return r
    return None


def release_problem(r, conf):
    if r is None:
        return 'not in the tested release list'
    if not DIGEST_RE.match(r['digest']) or r['digest'] == PLACEHOLDER_DIGEST:
        return 'has no pinned image digest (placeholder); this release cannot be installed'
    if not IMAGE_RE.match(r['image']):
        return 'names an image outside the official ONLYOFFICE repositories'
    if r['edition'] != conf['edition']:
        return f'is the {r["edition"]} edition; this deployment is configured for {conf["edition"]}'
    if not r['tested'] and not conf['allow_untested']:
        return ('has not passed clientst0r\'s live verification yet; set '
                'ALLOW_UNTESTED_RELEASES=yes in office-service.conf only on a test VM')
    return ''


def version_key(r):
    return tuple(int(x) for x in r['version'].split('.'))


def default_release(conf):
    usable = [r for r in RELEASES if not release_problem(r, conf)]
    return max(usable, key=version_key) if usable else None


def image_ref(r):
    return f'{r["image"]}@{r["digest"]}'


# ---------------------------------------------------------------------------
# secrets
