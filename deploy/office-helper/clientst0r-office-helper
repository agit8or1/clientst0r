def volumes(edition):
    return VOLUMES_COMMON + (VOLUMES_EE if edition == 'enterprise' else [])


def render_compose(conf, r):
    def q(value):
        return json.dumps(str(value))          # a JSON string is a valid YAML scalar

    env = {
        'JWT_ENABLED': 'true', 'JWT_HEADER': 'Authorization', 'JWT_IN_BODY': 'false',
        'WOPI_ENABLED': 'false',
        # The container may reach exactly one private address: the bridge
        # gateway on 443, enforced by the nftables table below. Docs' own
        # private-IP filter needs this switch for that one address
        # (IP_FILTER_RULES takes no CIDR and does not cover downloads).
        'ALLOW_PRIVATE_IP_ADDRESS': 'true', 'ALLOW_META_IP_ADDRESS': 'false',
        'PLUGINS_ENABLED': 'false', 'WELCOME_PAGE_ENABLED': 'false', 'EXAMPLE_ENABLED': 'false',
        'METRICS_ENABLED': 'false',
    }
    if r['edition'] == 'enterprise':
        env['ADMINPANEL_ENABLED'] = 'false'
    lines = [
        '# Generated by clientst0r-office-helper. Do not edit: it is rewritten on',
        '# every install, update and rollback from /etc/clientst0r/office-service.conf.',
        f'name: {PROJECT}',
        'services:',
        '  documentserver:',
        f'    image: {q(image_ref(r))}',
        f'    container_name: {CONTAINER}',
        '    restart: unless-stopped',
        f'    stop_grace_period: {STOP_GRACE}',
        '    env_file:',
        f'      - {q(ENV_FILE)}',
        '    environment:',
    ]
    lines += [f'      {k}: {q(v)}' for k, v in env.items()]
    lines += [
        '    ports:',
        f'      - {q(f"127.0.0.1:{conf["bind_port"]}:80")}',
        '    extra_hosts:',
        f'      - {q(conf["clientstor_host"] + ":" + conf["gateway"])}',
        '    volumes:',
    ]
    for name, inside in volumes(r['edition']):
        lines.append(f'      - {q(DATA_DIR + "/" + name + ":" + inside)}')
    lines += [
        f'    cpus: {conf["cpus"]}',
        f'    mem_limit: {conf["memory_mb"]}m',
        f'    memswap_limit: {conf["memory_mb"] + 2048}m',
        '    pids_limit: 4096',
        '    security_opt:',
        '      - "no-new-privileges:true"',
        '    logging:',
        '      driver: json-file',
        '      options:',
        '        max-size: "10m"',
        '        max-file: "3"',
        '    healthcheck:',
        '      test: ["CMD-SHELL", "[ \\"$(curl -fs http://127.0.0.1/healthcheck)\\" = true ]"]',
        '      interval: 30s',
        '      timeout: 10s',
        '      start_period: 120s',
        '      retries: 5',
        '    labels:',
        f'      org.clientst0r.office.deployment: {q(conf["deployment_id"])}',
        f'      org.clientst0r.office.release: {q(r["id"])}',
        '    networks:',
        '      - office',
        'networks:',
        '  office:',
        f'    name: {NETWORK}',
        '    driver: bridge',
        '    driver_opts:',
        f'      com.docker.network.bridge.name: {BRIDGE}',
        '    ipam:',
        '      config:',
        f'        - subnet: {q(conf["subnet"])}',
        f'          gateway: {q(conf["gateway"])}',
        '',
    ]
    return '\n'.join(lines)


def prepare_dirs(conf, r):
    for d in (BASE_DIR, DATA_DIR, COMPOSE_DIR, STATE_DIR, BACKUP_DIR):
        os.makedirs(P(d), mode=0o700 if d != DATA_DIR and d != BASE_DIR else 0o711, exist_ok=True)
    for name, _inside in volumes(r['edition']):
        os.makedirs(P(f'{DATA_DIR}/{name}'), mode=0o755, exist_ok=True)
    if r['edition'] == 'enterprise':
        if not os.path.exists(P(LICENSE_FILE)):
            raise HelperError(f'The Enterprise edition needs its license file at {LICENSE_FILE} '
                              '(root-owned). Without it the editor runs unlicensed.')
        _check_trusted(P(LICENSE_FILE))
        shutil.copyfile(P(LICENSE_FILE), P(f'{DATA_DIR}/data/license.lic'))
    certs = P(f'{DATA_DIR}/data/certs')
    if conf['private_ca']:
        _check_trusted(P(CA_FILE))
        os.makedirs(certs, mode=0o755, exist_ok=True)
        # Path the image reads NODE_EXTRA_CA_CERTS from by default (README).
        shutil.copyfile(P(CA_FILE), certs + '/extra-ca-certs.pem')
    elif os.path.exists(certs + '/extra-ca-certs.pem'):
        os.unlink(certs + '/extra-ca-certs.pem')


def write_compose(conf, r):
    ensure_secrets()
    prepare_dirs(conf, r)
    write_atomic(P(COMPOSE_FILE), render_compose(conf, r), 0o600)


# ---------------------------------------------------------------------------
# firewall: the container may reach the host gateway on 443, nothing else
# ---------------------------------------------------------------------------

def render_nft(conf):
    gw = conf['gateway']
    return f"""table inet {NFT_TABLE} {{
    chain input {{
        type filter hook input priority filter - 1; policy accept;
        iifname "{BRIDGE}" ct state established,related accept
        iifname "{BRIDGE}" ip daddr {gw} tcp dport 443 accept
        iifname "{BRIDGE}" drop
    }}
    chain forward {{
        type filter hook forward priority filter - 1; policy accept;
        iifname "{BRIDGE}" ct state established,related accept
        iifname "{BRIDGE}" drop
    }}
}}
"""


def apply_firewall(conf):
    # Replace only our own table, atomically: flush+define in one nft run.
    script = (f'table inet {NFT_TABLE}\ndelete table inet {NFT_TABLE}\n' + render_nft(conf))
    run(['nft', '-f', '-'], input_text=script, timeout=30, check=True)
    return 'firewall table applied'


