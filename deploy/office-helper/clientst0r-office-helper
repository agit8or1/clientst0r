class HelperError(Exception):
    """Refused or failed; the message is safe to show (no secrets)."""


def _enable_test_mode():
    """Honoured only for a non-root process (the test suite). Running as
    root, the environment is ignored, so nothing here can redirect the real
    helper."""
    global TEST_MODE, TEST_ROOT, TEST_UID, BASE_ENV
    root = os.environ.get('CLIENTST0R_OFFICE_HELPER_TEST_ROOT', '')
    if os.geteuid() == 0 or not root:
        return
    TEST_MODE, TEST_ROOT, TEST_UID = True, root.rstrip('/'), os.getuid()
    BASE_ENV = dict(BASE_ENV, PATH=os.environ.get('CLIENTST0R_OFFICE_HELPER_TEST_PATH', SAFE_PATH),
                    HOME=TEST_ROOT, DOCKER_CONFIG=TEST_ROOT + '/docker-cli')
    # The installer's test stubs (office/test_managed_installer.py) read these.
    BASE_ENV.update({k: v for k, v in os.environ.items() if k.startswith('STUB_')})


def P(path):
    return TEST_ROOT + path if TEST_MODE else path


