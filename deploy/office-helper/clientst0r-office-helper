def host_facts():
    mem = _meminfo()
    return {'mem_total_mb': mem.get('MemTotal', 0), 'mem_available_mb': mem.get('MemAvailable', 0),
            'swap_mb': mem.get('SwapTotal', 0), 'cpus': _cpu_count()}


def capacity(conf, engine):
    """Checks + a verdict for running `engine` with its configured limits
    next to clientst0r on this host. 'fail' refuses install."""
    limit, cpus, _port = engine_limits(conf, engine)
    h = host_facts()
    total, avail, swap, ncpu = h['mem_total_mb'], h['mem_available_mb'], h['swap_mb'], h['cpus']
    reserve = conf['reserve_mb']
    checks = []

    def add(key, status, detail):
        checks.append({'key': key, 'status': status, 'detail': detail})

    need = limit + reserve
    add('memory', 'pass' if total >= need else 'fail',
        f'{total} MB RAM; the editor is limited to {limit} MB and {reserve} MB stay for clientst0r '
        f'(needs {need} MB)')
    if avail:
        after = avail - limit
        if after < HOST_FREE_FAIL_MB:
            add('memory_available', 'fail',
                f'{avail} MB is available now; with the editor at its {limit} MB limit only {after} MB '
                f'would be left for clientst0r and the rest of this server (at least '
                f'{HOST_FREE_FAIL_MB} MB is required). Lower the limit, add RAM, or run the editor '
                'on a separate VM.')
        elif after < reserve:
            add('memory_available', 'warn',
                f'{avail} MB is available now; with the editor at its {limit} MB limit {after} MB '
                f'would be left, under the {reserve} MB reserve for clientst0r.')
        else:
            add('memory_available', 'pass',
                f'{avail} MB available now; {after} MB stay free with the editor at its limit.')
    if engine == 'onlyoffice' and limit < VENDOR_RECOMMENDED_MEMORY_MB:
        add('memory_limit', 'warn', f'MEMORY_MB {limit} is under ONLYOFFICE\'s recommended '
                                    f'{VENDOR_RECOMMENDED_MEMORY_MB} MB for the Docker image')
    if engine == 'collabora':
        users = max(0, (limit - 750) // 50)
        add('memory_limit', 'pass',
            f'{limit} MB for CODE: base processes plus about {users} active users at Collabora\'s '
            '50 MB per active user')
    left = ncpu - cpus
    add('cpu', 'fail' if left < 1 else ('warn' if left < 2 else 'pass'),
        f'{ncpu} CPU(s); the editor is limited to {cpus}, {left:g} stay for clientst0r'
        + (' (ONLYOFFICE recommends dual-core 2 GHz or better)' if engine == 'onlyoffice' else
           f' (Collabora sizes 1 vCPU per 15 active users: about {int(cpus * 15)} here)'))
    if engine == 'onlyoffice' and swap < 2048:
        add('swap', 'warn', f'{swap} MB swap; ONLYOFFICE recommends at least 2 GB (Docker) / 4 GB (Linux)')
    elif swap == 0:
        add('swap', 'warn', 'no swap: if memory runs out the kernel kills processes (clientst0r '
                            'included) instead of slowing down. The container limit keeps the '
                            'editor inside its share.')
    statuses = [c['status'] for c in checks]
    verdict = 'fail' if 'fail' in statuses else ('warn' if 'warn' in statuses else 'pass')
    label = ENGINES[engine]['label']
    if verdict == 'fail':
        rec = (f'{label} does not fit next to clientst0r on this server with these limits. Run it on '
               'a separate VM (install-editor.sh --mode separate-server, or an existing editor '
               'service), or add memory.')
    elif verdict == 'warn':
        rec = f'{label} fits with little headroom; watch memory and keep the limits as they are.'
    else:
        rec = f'{label} fits next to clientst0r with these limits.'
    return {'engine': engine, 'memory_limit_mb': limit, 'cpus': cpus, 'host': h,
            'verdict': verdict, 'checks': checks, 'recommendation': rec}


