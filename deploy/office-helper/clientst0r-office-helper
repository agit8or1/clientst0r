def _meminfo():
    out = {}
    try:
        with open(P('/proc/meminfo') if TEST_MODE and os.path.exists(P('/proc/meminfo'))
                  else '/proc/meminfo', encoding='ascii') as f:
            for line in f:
                key, _, rest = line.partition(':')
                out[key.strip()] = int(rest.split()[0]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return out


def _cpu_count():
    if TEST_MODE and os.environ.get('CLIENTST0R_OFFICE_HELPER_TEST_CPUS'):
        return int(os.environ['CLIENTST0R_OFFICE_HELPER_TEST_CPUS'])
    return os.cpu_count() or 1


def load_config():
    path = P(CONF_PATH)
    _check_trusted(path)
    raw = {}
    with open(path, encoding='utf-8') as f:
        for n, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if '=' not in line:
                raise HelperError(f'{CONF_PATH}:{n}: expected KEY=VALUE')
            key, value = line.split('=', 1)
            raw[key.strip()] = value.strip()
    return validate_config(raw)


