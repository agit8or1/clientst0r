def _have(argv):
    try:
        return run(argv, timeout=10).returncode == 0
    except HelperError:
        return False


def op_preflight(conf, args):
    engine = args.get('engine') or active_engine(conf)
    checks = []

    def add(key, status, detail):
        checks.append({'key': key, 'status': status, 'detail': detail})

    os_id = os_ver = ''
    try:
        with open(P('/etc/os-release') if TEST_MODE and os.path.exists(P('/etc/os-release'))
                  else '/etc/os-release', encoding='utf-8') as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k == 'ID':
                    os_id = v.strip('"')
                elif k == 'VERSION_ID':
                    os_ver = v.strip('"')
    except OSError:
        pass
    if (os_id, os_ver) in (('ubuntu', '24.04'), ('ubuntu', '22.04'), ('debian', '12')):
        add('os', 'pass', f'{os_id} {os_ver}')
    else:
        add('os', 'fail', f'{os_id or "unknown"} {os_ver}: supported are Ubuntu 22.04/24.04 and Debian 12')
    arch = platform.machine()
    if arch in ('x86_64', 'aarch64'):
        add('arch', 'pass' if arch == 'x86_64' else 'warn',
            arch + ('' if arch == 'x86_64' else ': the image is published for arm64; untested here'))
    else:
        add('arch', 'fail', f'{arch}: the images are published for amd64 and arm64 only')

    ok, version, detail = docker_available()
    add('docker', 'pass' if ok else 'fail',
        f'Docker {version}, Compose {detail}' if ok else
        f'Docker is not usable: {detail}. Run scripts/office/install-editor.sh --mode managed-local '
        '(it installs Docker only when none is present and never replaces an existing one).')
    if _have(['nft', '--version']):
        add('nftables', 'pass', 'nft available (container egress is restricted with it)')
    else:
        add('nftables', 'fail', 'nft is not installed; the container firewall cannot be applied')
    if engine == 'collabora':
        if _have(['openssl', 'version']):
            add('openssl', 'pass', 'openssl available (generates the WOPI proof key)')
        else:
            add('openssl', 'fail', 'openssl is not installed; the WOPI proof key cannot be generated')

    cap = capacity(conf, engine)
    checks += cap['checks']
    add('capacity', cap['verdict'], cap['recommendation'])

    target = P(BASE_DIR) if os.path.isdir(P(BASE_DIR)) else (P('/var/lib') if os.path.isdir(P('/var/lib')) else '/')
    st = os.statvfs(target)
    free_gb = st.f_bavail * st.f_frsize // (1024 ** 3)
    fail_gb, warn_gb = (DISK_FAIL_GB, DISK_WARN_GB) if engine == 'onlyoffice' else (4, 10)
    add('disk', 'fail' if free_gb < fail_gb else ('warn' if free_gb < warn_gb else 'pass'),
        f'{free_gb} GB free for {BASE_DIR} (fails under {fail_gb} GB, warns under {warn_gb} GB)')

    listeners = listening_ports()
    port = engine_limits(conf, engine)[2]
    cs = container_state(engine) if ok else {}
    if port in listeners and not cs.get('running'):
        add('port', 'fail', f'127.0.0.1:{port} is already in use by another program')
    else:
        add('port', 'pass', f'port {port} is free (or used by this editor)')
    if conf['proxy_tls'] == 'upstream':
        add('proxy', 'pass' if 80 in listeners else 'fail',
            'Nginx listens on 80 behind the TLS device in front of this server' if 80 in listeners else
            'nothing listens on 80: PROXY_TLS=upstream needs this server\'s Nginx on port 80')
    elif 443 in listeners:
        add('proxy', 'pass', 'a web server listens on 443')
    else:
        add('proxy', 'fail', 'nothing listens on 443: the reverse proxy for clientst0r and the office '
                             'host name must run on this VM (or set PROXY_TLS=upstream)')
    if conf['callback_route'] == 'gateway' and 443 not in listeners:
        add('callback', 'fail', 'CALLBACK_ROUTE=gateway sends the editor to this server\'s Nginx on 443, '
                                'but nothing listens there. With TLS terminated in front of this '
                                'server set CALLBACK_ROUTE=upstream and CALLBACK_UPSTREAM_IP.')
    else:
        add('callback', 'pass', f'the editor reaches clientst0r at {conf["callback_target"]}:443 '
                                f'({conf["callback_route"]})')
    if _have(['nginx', '-v']):
        add('nginx', 'pass', 'Nginx present (the helper manages only its own office files)')
    else:
        add('nginx', 'fail', 'Nginx is not installed')

    overlap = subnet_conflict(conf)
    add('subnet', 'fail' if overlap else 'pass',
        f'{conf["subnet"]} overlaps {overlap}; set NETWORK_SUBNET' if overlap else
        f'{conf["subnet"]} does not overlap a local route')
    layout = current_layout(conf, engine)
    host = public_host(conf, layout)
    for name, label in ((host, f'editor host name ({layout})'),
                        (conf['clientstor_host'], 'clientst0r host name')):
        if not name:
            continue
        try:
            addrs = sorted({a[4][0] for a in socket.getaddrinfo(name, 443, 0, socket.SOCK_STREAM)})
            add('dns', 'pass', f'{label} {name} resolves to {", ".join(addrs[:4])}')
        except (OSError, UnicodeError):
            add('dns', 'fail', f'{label} {name} does not resolve from this host')
    r = default_release(conf, engine)
    add('release', 'pass' if r else 'fail',
        f'will install {r["id"]}' if r else
        'no release in the list can be installed: ' + '; '.join(
            f'{x["id"]} {release_problem(x, conf)}' for x in engine_releases(engine)))
    if engine == 'onlyoffice' and conf['edition'] == 'enterprise' and not os.path.exists(P(LICENSE_FILE)):
        add('license', 'fail', f'Enterprise edition: put the license file at {LICENSE_FILE}')
    return {'engine': engine, 'checks': checks, 'passed': all(c['status'] != 'fail' for c in checks),
            'capacity': cap}


def listening_ports():
    ports = set()
    for name in ('/proc/net/tcp', '/proc/net/tcp6'):
        path = P(name) if TEST_MODE and os.path.exists(P(name)) else name
        try:
            with open(path, encoding='ascii') as f:
                next(f, None)
                for line in f:
                    parts = line.split()
                    if len(parts) > 3 and parts[3] == '0A':
                        ports.add(int(parts[1].rsplit(':', 1)[1], 16))
        except OSError:
            continue
    return ports


def subnet_conflict(conf):
    net = ipaddress.ip_network(conf['subnet'])
    r = run(['ip', '-j', 'route', 'show', 'table', 'all'], timeout=10)
    try:
        routes = json.loads(r.stdout or '[]') if r.returncode == 0 else []
    except ValueError:
        routes = []
    for route in routes:
        dst = route.get('dst', '')
        if not dst or dst == 'default' or route.get('dev') == BRIDGE:
            continue
        try:
            other = ipaddress.ip_network(dst, strict=False)
        except ValueError:
            continue
        if other.version == 4 and other.prefixlen > 0 and other.overlaps(net):
            return f'route {dst} on {route.get("dev", "?")}'
    return ''


def op_status(conf, args):
    j = reconcile_journal()
    ok, dver, cver = docker_available()
    engine = active_engine(conf)
    st = container_state(engine) if ok else {'exists': False}
