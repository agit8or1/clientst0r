def volumes(edition):
    return VOLUMES_COMMON + (VOLUMES_EE if edition == 'enterprise' else [])


def engine_volumes(r):
    """Data volumes a backup covers. CODE has none: documents live in
    clientst0r and its configuration is generated from this helper's."""
    return volumes(r['edition']) if r['engine'] == 'onlyoffice' else []


def _q(value):
    return json.dumps(str(value))          # a JSON string is a valid YAML scalar


def _network_block(conf):
    return [
        'networks:',
        '  office:',
        f'    name: {NETWORK}',
        '    driver: bridge',
        '    driver_opts:',
        f'      com.docker.network.bridge.name: {BRIDGE}',
        '    ipam:',
        '      config:',
        f'        - subnet: {_q(conf["subnet"])}',
        f'          gateway: {_q(conf["gateway"])}',
        '',
    ]


def render_compose(conf, r):
    if r['engine'] == 'collabora':
        return render_cool_compose(conf, r)
    return render_oo_compose(conf, r)


def render_oo_compose(conf, r):
    q = _q
    env = {
        'JWT_ENABLED': 'true', 'JWT_HEADER': 'Authorization', 'JWT_IN_BODY': 'false',
        'WOPI_ENABLED': 'false',
        # The container may reach exactly one private address: the bridge
        # gateway on 443, enforced by the nftables table below. Docs' own
        # private-IP filter needs this switch for that one address
        # (IP_FILTER_RULES takes no CIDR and does not cover downloads).
        'ALLOW_PRIVATE_IP_ADDRESS': 'true', 'ALLOW_META_IP_ADDRESS': 'false',
        'PLUGINS_ENABLED': 'false', 'WELCOME_PAGE_ENABLED': 'false', 'EXAMPLE_ENABLED': 'false',
        'METRICS_ENABLED': 'false',
    }
    if r['edition'] == 'enterprise':
        env['ADMINPANEL_ENABLED'] = 'false'
    lines = [
        '# Generated by clientst0r-office-helper. Do not edit: it is rewritten on',
        '# every install, update and rollback from /etc/clientst0r/office-service.conf.',
        f'name: {PROJECT}',
        'services:',
        '  documentserver:',
        f'    image: {q(image_ref(r))}',
        f'    container_name: {CONTAINER}',
        '    restart: unless-stopped',
        f'    stop_grace_period: {STOP_GRACE}',
        '    env_file:',
        f'      - {q(ENV_FILE)}',
        '    environment:',
    ]
    lines += [f'      {k}: {q(v)}' for k, v in env.items()]
    lines += [
        '    ports:',
        f'      - {q(f"127.0.0.1:{conf["bind_port"]}:80")}',
        '    extra_hosts:',
        f'      - {q(conf["clientstor_host"] + ":" + conf["callback_target"])}',
        '    volumes:',
    ]
    for name, inside in volumes(r['edition']):
        lines.append(f'      - {q(DATA_DIR + "/" + name + ":" + inside)}')
    lines += [
        f'    cpus: {conf["cpus"]}',
        f'    mem_limit: {conf["memory_mb"]}m',
        f'    memswap_limit: {conf["memory_mb"] + 2048}m',
        '    pids_limit: 4096',
        '    security_opt:',
        '      - "no-new-privileges:true"',
        '    logging:',
        '      driver: json-file',
        '      options:',
        '        max-size: "10m"',
        '        max-file: "3"',
        '    healthcheck:',
        '      test: ["CMD-SHELL", "[ \\"$(curl -fs http://127.0.0.1/healthcheck)\\" = true ]"]',
        '      interval: 30s',
        '      timeout: 10s',
        '      start_period: 120s',
        '      retries: 5',
        '    labels:',
        f'      org.clientst0r.office.deployment: {q(conf["deployment_id"])}',
        f'      org.clientst0r.office.release: {q(r["id"])}',
        '    networks:',
        '      - office',
    ]
    return '\n'.join(lines + _network_block(conf))


def cool_options(conf, layout):
    """coolwsd options, passed as separate container arguments (the image's
    start script hands "$@" to coolwsd unchanged, so a value with a space
    such as the CSP stays one argument). Fixed here; nothing comes from the
    app."""
    origin = f'https://{conf["clientstor_host"]}'
    return [
        # TLS is terminated by Nginx (or the device in front of it).
        '--o:ssl.enable=false', '--o:ssl.termination=true',
        # Only clientst0r may frame the editor.
        f'--o:net.content_security_policy=frame-ancestors {origin}',
        # Only clientst0r is a WOPI host (aliasgroup1 below), in groups mode
        # so the "first host that connects" rule never applies.
        '--o:storage.wopi.alias_groups[@mode]=groups',
        '--o:admin_console.enable=false',
        '--o:security.enable_macros_execution=false',
        '--o:net.proto=IPv4',
        '--o:num_prespawn_children=1',
        '--o:logging.level=warning',
    ]


def render_cool_compose(conf, r):
    q = _q
    layout = current_layout(conf, 'collabora')
    host = public_host(conf, layout)
    if not HOST_RE.match(host or ''):
        raise HelperError(f'no host name for the {layout} layout (set OFFICE_HOSTNAME)')
    env = {
        'DONT_GEN_SSL_CERT': '1',
        'aliasgroup1': f'https://{conf["clientstor_host"]}:443',
        'server_name': host,
    }
    lines = [
        '# Generated by clientst0r-office-helper. Do not edit: it is rewritten on',
        '# every install, update, rollback and layout change from',
        '# /etc/clientst0r/office-service.conf.',
        f'name: {ENGINES["collabora"]["project"]}',
        'services:',
        '  coolwsd:',
        f'    image: {q(image_ref(r))}',
        f'    container_name: {ENGINES["collabora"]["container"]}',
        '    restart: unless-stopped',
        '    stop_grace_period: 2m',
        '    env_file:',
        f'      - {q(COOL_ENV_FILE)}',
        '    environment:',
    ]
    lines += [f'      {k}: {q(v)}' for k, v in env.items()]
    lines.append('    command:')
    lines += [f'      - {q(o)}' for o in cool_options(conf, layout)]
    lines += [
        '    ports:',
        f'      - {q(f"127.0.0.1:{conf["cool_bind_port"]}:9980")}',
        '    extra_hosts:',
        f'      - {q(conf["clientstor_host"] + ":" + conf["callback_target"])}',
        '    volumes:',
        f'      - {q(COOL_PROOF_KEY + ":/etc/coolwsd/proof_key:ro")}',
        f'    cpus: {conf["cool_cpus"]}',
        f'    mem_limit: {conf["cool_memory_mb"]}m',
        f'    memswap_limit: {conf["cool_memory_mb"]}m',
        '    pids_limit: 2048',
        # No "no-new-privileges" here: coolforkit-caps carries file
        # capabilities (cap_fowner, cap_chown, cap_sys_chroot; image
        # Dockerfile) to build each document's jail, and no-new-privileges
        # would strip them. Raw sockets are not needed.
        '    cap_drop:',
        '      - NET_RAW',
        '    logging:',
        '      driver: json-file',
        '      options:',
        '        max-size: "10m"',
        '        max-file: "3"',
        '    labels:',
        f'      org.clientst0r.office.deployment: {q(conf["deployment_id"])}',
        f'      org.clientst0r.office.release: {q(r["id"])}',
        f'      org.clientst0r.office.layout: {q(layout)}',
        '    networks:',
        '      - office',
    ]
    return '\n'.join(lines + _network_block(conf))


def prepare_dirs(conf, r):
    for d in (BASE_DIR, DATA_DIR, COMPOSE_DIR, STATE_DIR, BACKUP_DIR):
        os.makedirs(P(d), mode=0o700 if d != DATA_DIR and d != BASE_DIR else 0o711, exist_ok=True)
    if r['engine'] == 'collabora':
        ensure_cool_secrets()
        return
    for name, _inside in volumes(r['edition']):
        os.makedirs(P(f'{DATA_DIR}/{name}'), mode=0o755, exist_ok=True)
    if r['edition'] == 'enterprise':
        if not os.path.exists(P(LICENSE_FILE)):
            raise HelperError(f'The Enterprise edition needs its license file at {LICENSE_FILE} '
                              '(root-owned). Without it the editor runs unlicensed.')
        _check_trusted(P(LICENSE_FILE))
        shutil.copyfile(P(LICENSE_FILE), P(f'{DATA_DIR}/data/license.lic'))
    certs = P(f'{DATA_DIR}/data/certs')
    if conf['private_ca']:
        _check_trusted(P(CA_FILE))
        os.makedirs(certs, mode=0o755, exist_ok=True)
        # Path the image reads NODE_EXTRA_CA_CERTS from by default (README).
        shutil.copyfile(P(CA_FILE), certs + '/extra-ca-certs.pem')
    elif os.path.exists(certs + '/extra-ca-certs.pem'):
        os.unlink(certs + '/extra-ca-certs.pem')


def write_compose(conf, r):
    if r['engine'] == 'onlyoffice':
        ensure_secrets()
    prepare_dirs(conf, r)
    write_atomic(P(ENGINES[r['engine']]['compose_file']), render_compose(conf, r), 0o600)


# ---------------------------------------------------------------------------
# firewall: the container may reach exactly one destination on 443
# ---------------------------------------------------------------------------

def render_nft(conf):
    gw = conf['gateway']
    if conf['callback_route'] == 'upstream':
        # clientst0r's TLS is terminated on a device in front of this host:
        # the container may reach that one address on 443 (forwarded), and
        # nothing on this host itself.
        up = conf['upstream_ip']
        return f"""table inet {NFT_TABLE} {{
    chain input {{
        type filter hook input priority filter - 1; policy accept;
        iifname "{BRIDGE}" ct state established,related accept
        iifname "{BRIDGE}" drop
    }}
    chain forward {{
        type filter hook forward priority filter - 1; policy accept;
        iifname "{BRIDGE}" ct state established,related accept
        iifname "{BRIDGE}" ip daddr {up} tcp dport 443 accept
        iifname "{BRIDGE}" drop
    }}
}}
"""
    return f"""table inet {NFT_TABLE} {{
    chain input {{
        type filter hook input priority filter - 1; policy accept;
        iifname "{BRIDGE}" ct state established,related accept
        iifname "{BRIDGE}" ip daddr {gw} tcp dport 443 accept
        iifname "{BRIDGE}" drop
    }}
    chain forward {{
        type filter hook forward priority filter - 1; policy accept;
        iifname "{BRIDGE}" ct state established,related accept
        iifname "{BRIDGE}" drop
    }}
}}
"""


def apply_firewall(conf):
    # Replace only our own table, atomically: flush+define in one nft run.
    script = (f'table inet {NFT_TABLE}\ndelete table inet {NFT_TABLE}\n' + render_nft(conf))
    run(['nft', '-f', '-'], input_text=script, timeout=30, check=True)
    return 'firewall table applied'


