def take_backup(conf, rel_id, reason, progress):
    r = release(rel_id)
    if r is None:
        raise HelperError(f'cannot back up: installed release {rel_id!r} is unknown')
    st = container_state(r['engine'])
    if st.get('running'):
        raise HelperError('internal: backups are taken only with the editor stopped')
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    bid = f'{stamp}-{rel_id}-{reason}'
    target = P(f'{BACKUP_DIR}/{bid}')
    os.makedirs(target, mode=0o700)
    progress(f'backing up editor data and configuration ({bid})')
    tar_path = target + '/state.tar'
    with tarfile.open(tar_path, 'w') as tar:
        for name, _inside in engine_volumes(r):
            if name in BACKUP_EXCLUDE:
                continue
            src = P(f'{DATA_DIR}/{name}')
            if os.path.isdir(src):
                tar.add(src, arcname=f'data/{name}')
        files = [(ENGINES[r['engine']]['compose_file'], 'compose.yaml'),
                 (INSTALLED_FILE, 'installed.json'), (PROXY_STATE_FILE, 'proxy.json')]
        if r['engine'] == 'onlyoffice':
            files += [(JWT_FILE, 'secrets/jwt.secret'), (LINK_FILE, 'secrets/securelink.secret')]
        else:
            files += [(COOL_ADMIN_FILE, 'secrets/collabora-admin.secret'),
                      (COOL_PROOF_KEY, 'secrets/collabora-proof_key')]
        for path, arc in files:
            if os.path.exists(P(path)):
                tar.add(P(path), arcname=arc)
    with open(tar_path, 'rb') as f:
        os.fsync(f.fileno())
    manifest = {'id': bid, 'release': rel_id, 'digest': r['digest'], 'compat': r['compat'],
                'edition': r['edition'], 'engine': r['engine'], 'reason': reason,
                'created_at': now_iso(), 'size': os.path.getsize(tar_path),
                'helper_version': HELPER_VERSION}
    write_atomic(target + '/manifest.json', json.dumps(manifest, indent=1), 0o600)
    history({'event': 'backup', 'backup': bid})
    return manifest


def list_backups():
    out = []
    base = P(BACKUP_DIR)
    if not os.path.isdir(base):
        return out
    for name in sorted(os.listdir(base)):
        m = read_json(os.path.join(base, name, 'manifest.json'))
        if m and m.get('id') == name:
            out.append(m)
    return out


def prune_backups(keep_ids):
    backups = list_backups()
    removable = [b for b in backups if b['id'] not in keep_ids]
    for b in removable[:max(0, len(backups) - KEEP_BACKUPS)]:
        shutil.rmtree(P(f'{BACKUP_DIR}/{b["id"]}'), ignore_errors=True)


def restore_backup(manifest, progress):
    progress(f'restoring editor data from backup {manifest["id"]}')
    tar_path = P(f'{BACKUP_DIR}/{manifest["id"]}/state.tar')
    if not os.path.exists(tar_path) or os.path.getsize(tar_path) != manifest.get('size'):
        raise HelperError(f'backup {manifest["id"]} is missing or incomplete')
    r = release(manifest['release'])
    with tarfile.open(tar_path, 'r') as tar:
        members = [m for m in tar.getmembers() if m.name.startswith('data/')]
        for m in members:
            parts = m.name.split('/')
            bad_link = m.issym() and (m.linkname.startswith('/') or '..' in m.linkname.split('/'))
            if '..' in parts or m.name.startswith('/') or bad_link \
                    or not (m.isdir() or m.isfile() or m.issym()):
                raise HelperError(f'backup {manifest["id"]} contains an unexpected entry')
        for name, _inside in engine_volumes(r):
            if name in BACKUP_EXCLUDE:
                continue
            dest = P(f'{DATA_DIR}/{name}')
            if os.path.isdir(dest):
                shutil.rmtree(dest)
        if hasattr(tarfile, 'tar_filter'):
            tar.extractall(P(BASE_DIR), members=members, filter='tar')
        else:   # Python without extraction filters: entries were checked above
            tar.extractall(P(BASE_DIR), members=members)
    history({'event': 'restore', 'backup': manifest['id']})


# ---------------------------------------------------------------------------
# operation journal + lock
# ---------------------------------------------------------------------------

def _boot_id():
    try:
        with open('/proc/sys/kernel/random/boot_id', encoding='ascii') as f:
            return f.read().strip()
    except OSError:
        return ''


def journal():
    return read_json(P(JOURNAL_FILE), {}) or {}


def write_journal(data):
    write_atomic(P(JOURNAL_FILE), json.dumps(data, indent=1, sort_keys=True), 0o640)


def acquire_lock():
    os.makedirs(P(RUN_DIR), mode=0o755, exist_ok=True)
    fd = os.open(P(LOCK_FILE), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def reconcile_journal():
    """A journal that says 'running' while nobody holds the lock (process
    killed, VM rebooted) is marked 'interrupted'. It is never resumed by
    itself: the app (or an administrator) retries the operation, and every
    operation converges from whatever state it finds."""
    j = journal()
    if j.get('state') != 'running':
        return j
    fd = acquire_lock()
    if fd is None:
        return j            # really running
    try:
        j = journal()
        if j.get('state') == 'running':
            j.update(state='interrupted', finished_at=now_iso(),
                     error=f'interrupted during "{j.get("step", "?")}" '
                           f'({"after a reboot" if j.get("boot_id") != _boot_id() else "process ended"})')
            write_journal(j)
            history({'event': 'interrupted', 'op': j.get('op'), 'id': j.get('id')})
    finally:
        os.close(fd)
    return j


# ---------------------------------------------------------------------------
# reverse proxy (Nginx): only this helper's own files, validated, tested
# ---------------------------------------------------------------------------

def _strip_comments(text):
    return '\n'.join(line.split('#', 1)[0] for line in text.splitlines())


def detect_sites(conf):
    """Read-only look at /etc/nginx/sites-enabled: which file serves which
    names, and whether clientst0r's site includes the same-host snippet.
    Nothing here writes anything."""
    out = []
    d = P(NGINX_ENABLED)
    if not os.path.isdir(d):
        return out
    for name in sorted(os.listdir(d)):
        path = os.path.join(d, name)
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                text = _strip_comments(f.read(512 * 1024))
        except OSError:
            continue
        names = []
        for group in re.findall(r'\bserver_name\s+([^;]+);', text):
            names += group.split()
        listens = [x.strip() for x in re.findall(r'\blisten\s+([^;]+);', text)]
        real = os.path.realpath(path)
        if TEST_MODE and real.startswith(TEST_ROOT):
            real = real[len(TEST_ROOT):]
        out.append({
            'file': name, 'path': real, 'server_names': names[:20], 'listen': listens[:10],
            'ours': name == SITE_NAME,
            'default': '_' in names or any('default_server' in x for x in listens),
            'includes_snippet': bool(re.search(r'^\s*include\s+' + re.escape(SNIPPET_FILE) + r'\s*;',
                                               text, re.M)),
        })
    return out


def clientstor_site(conf, sites):
    for s in sites:
        if not s['ours'] and conf['clientstor_host'] in s['server_names']:
            return s
    for s in sites:
        if not s['ours'] and s['default']:
            return s
    return None


def tls_files(conf, host):
    if conf['proxy_tls'] == 'letsencrypt':
        return f'/etc/letsencrypt/live/{host}/fullchain.pem', f'/etc/letsencrypt/live/{host}/privkey.pem'
    if conf['proxy_tls'] == 'local-cert':
        if not conf['cert_file'] or not conf['key_file']:
            raise HelperError('PROXY_TLS=local-cert needs PROXY_CERT_FILE and PROXY_KEY_FILE in '
                              f'{CONF_PATH}')
        return conf['cert_file'], conf['key_file']
    return None, None


def cert_info(conf, host):
    """For a certificate this server holds: present, valid now, matches the
    host name. (PROXY_TLS=upstream: the certificate is on the device in
    front; the app checks it over HTTPS instead.)"""
    if conf['proxy_tls'] == 'upstream':
        return {'mode': 'upstream', 'checked_here': False,
                'detail': 'TLS is terminated on the device in front of this server.'}
    try:
        cert, key = tls_files(conf, host)
    except HelperError as e:
        return {'mode': conf['proxy_tls'], 'checked_here': True, 'ok': False, 'detail': str(e)}
    if not os.path.exists(P(cert)) or not os.path.exists(P(key)):
        return {'mode': conf['proxy_tls'], 'checked_here': True, 'ok': False, 'path': cert,
                'detail': f'{cert} or its key is missing'}
    r = run(['openssl', 'x509', '-in', P(cert), '-noout', '-enddate', '-checkend', '0',
             '-checkhost', host], timeout=20)
    text = (r.stdout or '') + (r.stderr or '')
    matches = 'does match certificate' in text and 'NOT match' not in text
    valid = 'will not expire' in text
    m = re.search(r'notAfter=(.+)', text)
    return {'mode': conf['proxy_tls'], 'checked_here': True, 'path': cert, 'ok': matches and valid,
            'matches_host': matches, 'valid_now': valid, 'not_after': (m.group(1).strip() if m else ''),
            'detail': ('valid for ' + host) if matches and valid else
            ('does not cover ' + host if not matches else 'expired')}


PROXY_HEADERS = [
    'proxy_http_version 1.1;',
    'proxy_set_header Host $host;',
    'proxy_set_header X-Forwarded-Host $host;',
    'proxy_set_header X-Forwarded-Proto https;',
    'proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;',
    'proxy_set_header X-Real-IP $remote_addr;',
    # clientst0r's session/CSRF cookies and any Authorization header never
    # reach the editor, and the editor cannot set cookies on this host.
    'proxy_set_header Cookie "";',
    'proxy_set_header Authorization "";',
    'proxy_hide_header Set-Cookie;',
    'proxy_buffering off;',
    'proxy_connect_timeout 10s;',
    # Own headers here, so the server-level X-Frame-Options of clientst0r's
    # site is not inherited (the editor is framed; its own CSP
    # frame-ancestors names clientst0r only).
    'add_header X-Content-Type-Options nosniff always;',
    'add_header Referrer-Policy same-origin always;',
]


STRIP_LINES = ('proxy_set_header Cookie "";', 'proxy_set_header Authorization "";',
               'proxy_hide_header Set-Cookie;')


def _location(match, port, *, websocket=False, log=False, extra=(), strip=True):
    body = [f'proxy_pass http://127.0.0.1:{port};'] + [
        h for h in PROXY_HEADERS if strip or h not in STRIP_LINES]
    if websocket:
        body += ['proxy_set_header Upgrade $http_upgrade;', 'proxy_set_header Connection "Upgrade";',
                 'proxy_read_timeout 36000s;', 'proxy_send_timeout 36000s;']
    else:
        body += ['proxy_read_timeout 3600s;', 'proxy_send_timeout 3600s;']
    if not log:
        # Collabora URLs carry the WOPI access token in their path/query.
        body.append('access_log off;')
    body += list(extra)
    return [f'location {match} {{'] + ['    ' + x for x in body] + ['}']


def cool_locations(conf):
    """The paths Collabora Online serves, after its documented Nginx proxy
    layout: static files (/browser), discovery and capabilities (/hosting),
    the document WebSocket (/cool/.../ws and /cool/ws), and the rest of
    /cool (download, upload, presentation, conversion). The admin console
    and metrics are refused."""
    port = conf['cool_bind_port']
    body = f'client_max_body_size {conf["max_body_mb"]}m;'
    out = []
    for match in ('= /cool/getMetrics', '^~ /cool/adminws', '^~ /browser/dist/admin'):
        out += [f'location {match} {{', '    return 403;', '}']
    out += _location('^~ /browser/', port, extra=[body])
    out += _location('^~ /hosting/discovery', port)
    out += _location('^~ /hosting/capabilities', port)
    out += _location('~ ^/cool/(.*/)?ws$', port, websocket=True)
    out += _location('~ ^/(cool|lool)/', port, extra=[body])
    return out


def render_dedicated(conf, engine, host):
    if not HOST_RE.match(host or ''):
        raise HelperError('the dedicated layout needs OFFICE_HOSTNAME')
    port = engine_limits(conf, engine)[2]
    head = [NGINX_MARKER,
            f'# {ENGINES[engine]["label"]}: {host} -> 127.0.0.1:{port} (loopback only).',
            '# Rewritten by the helper (proxy-install / set-layout / install). clientst0r\'s own',
            '# site is never edited.', '']
    if engine == 'onlyoffice':
        head += ['map $http_upgrade $clientst0r_office_managed_upgrade {', '    default upgrade;',
                 "    '' close;", '}', '']
        locations = _location('/', port, log=True, strip=False)[:-1] + [
            '    proxy_set_header Upgrade $http_upgrade;',
            '    proxy_set_header Connection $clientst0r_office_managed_upgrade;', '}']
    else:
        locations = cool_locations(conf) + ['location / {', '    return 404;', '}']
    common = [f'server_name {host};', f'client_max_body_size {conf["max_body_mb"]}m;',
              'server_tokens off;',
              f'access_log /var/log/nginx/{SITE_NAME}-access.log;',
              f'error_log /var/log/nginx/{SITE_NAME}-error.log;']
    ind = lambda lines: ['    ' + x if x else '' for x in lines]   # noqa: E731
    if conf['proxy_tls'] == 'upstream':
        # TLS ends on the device in front; it forwards plain HTTP here.
        server = ['server {', '    listen 80;', '    listen [::]:80;'] + ind(common) + [''] \
            + ind(locations) + ['}']
        return '\n'.join(head + server) + '\n'
    cert, key = tls_files(conf, host)
    if conf['proxy_tls'] == 'letsencrypt' and not os.path.exists(P(cert)):
        # First run: serve only the ACME challenge so certbot --webroot can
        # obtain the certificate; proxy-install again afterwards.
        acme = ['server {', '    listen 80;', '    listen [::]:80;', f'    server_name {host};',
                f'    location /.well-known/acme-challenge/ {{ root {ACME_DIR}; }}',
                '    location / { return 404; }', '}']
        return '\n'.join(head + ['# ACME-only until the certificate exists.'] + acme) + '\n'
    plain = ['server {', '    listen 80;', '    listen [::]:80;', f'    server_name {host};',
             f'    location /.well-known/acme-challenge/ {{ root {ACME_DIR}; }}',
             '    location / { return 301 https://$host$request_uri; }', '}', '']
    tls = ['server {', '    listen 443 ssl;', '    listen [::]:443 ssl;'] + ind(common) + [
        f'    ssl_certificate {cert};', f'    ssl_certificate_key {key};',
        '    ssl_protocols TLSv1.2 TLSv1.3;',
        '    add_header Strict-Transport-Security "max-age=31536000" always;', ''] \
        + ind(locations) + ['}']
    return '\n'.join(head + plain + tls) + '\n'


EMPTY_SNIPPET = (NGINX_MARKER + '\n# Same-host layout is not active. This file stays (empty) so an include of\n'
                 '# it in clientst0r\'s server block keeps working.\n')


def render_snippet(conf):
    lines = [NGINX_MARKER,
             '# Collabora Online on clientst0r\'s own host name (same-host layout).',
             '# Included ONCE by the administrator inside clientst0r\'s server block:',
             f'#     {INCLUDE_LINE}',
             '# WARNING: the editor\'s front-end runs on clientst0r\'s origin. Cookies and',
             '# Authorization are stripped towards the editor and Set-Cookie from it, but',
             '# its JavaScript is same-origin with clientst0r. Prefer a dedicated host name.', '']
    return '\n'.join(lines + cool_locations(conf)) + '\n'


def render_proxy(conf, engine, layout):
    """(site file text or None, snippet text)."""
    if layout == 'same-host':
        if engine != 'collabora':
            raise HelperError('the same-host layout is supported for Collabora only')
        return None, render_snippet(conf)
    return render_dedicated(conf, engine, conf['office_hostname']), EMPTY_SNIPPET


def _ours(path):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            head = f.read(200)
    except FileNotFoundError:
        return True
    return any(head.startswith(m) for m in NGINX_MARKERS)


def _link_ok(path):
    if not os.path.lexists(path):
        return True
    return os.path.islink(path) and os.readlink(path) in (SITE_FILE, P(SITE_FILE))


def _read(path):
    try:
        with open(path, encoding='utf-8') as f:
            return f.read()
    except FileNotFoundError:
        return None


def nginx_test():
    r = run(['nginx', '-t'], timeout=30)
    return r.returncode == 0, redact((r.stderr or r.stdout or '').strip())[-400:]


def _write_proxy_files(site_text, snippet_text):
    os.makedirs(P(SNIPPET_DIR), mode=0o755, exist_ok=True)
    os.chmod(P(SNIPPET_DIR), 0o755)
    write_atomic(P(SNIPPET_FILE), snippet_text, 0o644)
    if site_text is None:
        if os.path.lexists(P(SITE_LINK)):
            os.unlink(P(SITE_LINK))
        if os.path.exists(P(SITE_FILE)):
            os.unlink(P(SITE_FILE))
    else:
        write_atomic(P(SITE_FILE), site_text, 0o644)
        if not os.path.lexists(P(SITE_LINK)):
            os.symlink(P(SITE_FILE), P(SITE_LINK))


def install_proxy(conf, engine, layout, progress=lambda s: None, *, hostname=None):
    """Write this helper's Nginx files for (engine, layout), test, reload.
    On any failure the previous files are put back and Nginx is not left
    with a broken configuration."""
    host = public_host(conf, layout)
    if hostname is not None and hostname != host:
        raise HelperError(f'the {layout} layout serves {host or "(no host name configured)"}, '
                          f'not {hostname}')
    if not HOST_RE.match(host or ''):
        raise HelperError(f'no valid host name for the {layout} layout')
    if layout not in conf['layouts'] or layout not in ENGINES[engine]['layouts']:
        raise HelperError(f'the {layout} layout is not allowed for {ENGINES[engine]["label"]} '
                          'here (PROXY_LAYOUTS)')
    if not os.path.isdir(P(NGINX_AVAILABLE)) or not os.path.isdir(P(NGINX_ENABLED)):
        raise HelperError('Nginx with sites-available/ and sites-enabled/ was not found')
    site_text, snippet_text = render_proxy(conf, engine, layout)
    sites = detect_sites(conf)
    if layout == 'dedicated':
        for s in sites:
            if not s['ours'] and host in s['server_names']:
                raise HelperError(f'{host} is already served by {s["file"]}; this helper does not '
                                  'touch other sites')
        cert, key = tls_files(conf, host)
        if conf['proxy_tls'] == 'local-cert':
            for path in (cert, key):
                if not os.path.exists(P(path)):
                    raise HelperError(f'certificate file {path} is missing (PROXY_TLS=local-cert)')
    for path in (P(SITE_FILE), P(SNIPPET_FILE)):
        if not _ours(path):
            raise HelperError(f'{path} exists and was not written by clientst0r; refusing to replace it')
    if not _link_ok(P(SITE_LINK)):
        raise HelperError(f'{SITE_LINK} exists and is not this helper\'s link')
    before = {'site': _read(P(SITE_FILE)), 'snippet': _read(P(SNIPPET_FILE)),
              'link': os.path.lexists(P(SITE_LINK))}

    def restore():
        if before['snippet'] is None:
            if os.path.exists(P(SNIPPET_FILE)):
                os.unlink(P(SNIPPET_FILE))
        else:
            write_atomic(P(SNIPPET_FILE), before['snippet'], 0o644)
        if before['site'] is None:
            if os.path.exists(P(SITE_FILE)):
                os.unlink(P(SITE_FILE))
        else:
            write_atomic(P(SITE_FILE), before['site'], 0o644)
        if before['link'] and not os.path.lexists(P(SITE_LINK)):
            os.symlink(P(SITE_FILE), P(SITE_LINK))
        if not before['link'] and os.path.lexists(P(SITE_LINK)):
            os.unlink(P(SITE_LINK))

    progress(f'writing the Nginx configuration for {host} ({layout})')
    _write_proxy_files(site_text, snippet_text)
    ok, detail = nginx_test()
    if not ok:
        restore()
        raise HelperError('nginx -t rejected the new configuration; the previous files were put back '
                          'and Nginx was not reloaded: ' + detail)
    r = run(['systemctl', 'reload', 'nginx'], timeout=60)
    if r.returncode != 0:
        restore()
        if nginx_test()[0]:
            run(['systemctl', 'reload', 'nginx'], timeout=60)
        raise HelperError('reloading Nginx failed; the previous files were put back: '
                          + redact(r.stderr.strip())[-300:])
    site = clientstor_site(conf, sites)
    include_present = bool(site and site['includes_snippet'])
    state = {'installed': True, 'engine': engine, 'layout': layout, 'hostname': host,
             'tls': conf['proxy_tls'], 'installed_at': now_iso(), 'include_present': include_present}
    write_atomic(P(PROXY_STATE_FILE), json.dumps(state, indent=1, sort_keys=True), 0o600)
    history({'event': 'proxy-install', 'engine': engine, 'layout': layout, 'host': host})
    note = ''
    if layout == 'same-host' and not include_present:
        where = site['file'] if site else "clientst0r's Nginx site"
        note = (f'Add "{INCLUDE_LINE}" once inside the server block of {where}, then run '
                'nginx -t and reload Nginx. This helper never edits that file.')
    return dict(state, note=note)


def op_proxy_status(conf, args):
    engine = active_engine(conf)
    layout = current_layout(conf, engine)
    host = public_host(conf, layout)
    sites = detect_sites(conf)
    site = clientstor_site(conf, sites)
    try:
        site_text, snippet_text = render_proxy(conf, engine, layout)
        problem = ''
    except HelperError as e:
        site_text, snippet_text, problem = None, None, str(e)
    cur_site, cur_snip = _read(P(SITE_FILE)), _read(P(SNIPPET_FILE))
    files = {
        'site': {'path': SITE_FILE, 'present': cur_site is not None, 'ours': _ours(P(SITE_FILE)),
                 'enabled': os.path.lexists(P(SITE_LINK)) and _link_ok(P(SITE_LINK)),
                 'current': cur_site == site_text},
        'snippet': {'path': SNIPPET_FILE, 'present': cur_snip is not None,
                    'ours': _ours(P(SNIPPET_FILE)), 'current': cur_snip == snippet_text},
    }
    dns = {}
    for label, name in (('editor', host), ('clientstor', conf['clientstor_host'])):
        try:
            dns[label] = sorted({a[4][0] for a in socket.getaddrinfo(name, 443, 0, socket.SOCK_STREAM)})
        except (OSError, UnicodeError):
            dns[label] = []
    local = local_addresses()
    dns['points_here'] = bool(dns['editor']) and (
        bool(set(dns['editor']) & local) or set(dns['editor']) == set(dns['clientstor'])
        or (conf['upstream_ip'] and conf['upstream_ip'] in dns['editor']))
    installed_ok = (files['snippet']['present'] and files['snippet']['current'] and (
        layout == 'same-host' or (files['site']['current'] and files['site']['enabled'])))
    return {
        'engine': engine, 'layout': layout, 'hostname': host, 'tls': conf['proxy_tls'],
        'layouts_allowed': [x for x in conf['layouts'] if x in ENGINES[engine]['layouts']],
        'state': proxy_state(), 'files': files, 'installed': bool(installed_ok), 'problem': problem,
        'sites': sites, 'clientstor_site': site, 'include_line': INCLUDE_LINE,
        'include_needed': layout == 'same-host',
        'include_present': bool(site and site['includes_snippet']),
        'dns': dns, 'certificate': cert_info(conf, host) if layout == 'dedicated' else
        {'mode': 'same-host', 'checked_here': False,
         'detail': 'served with clientst0r\'s own certificate'},
        'preview': {'site': site_text, 'snippet': snippet_text},
    }


def local_addresses():
    r = run(['ip', '-j', 'addr', 'show'], timeout=10)
    out = set()
    try:
        for dev in json.loads(r.stdout or '[]') if r.returncode == 0 else []:
            for a in dev.get('addr_info') or []:
                if a.get('local'):
                    out.add(a['local'])
    except (ValueError, AttributeError):
        pass
    return out


def _with_lock(fn):
    fd = acquire_lock()
    if fd is None:
        j = journal()
        raise HelperError(f'another operation is running ({j.get("op", "?")}); try again when it '
                          'has finished')
    try:
        return fn()
    finally:
        os.close(fd)


def op_proxy_install(conf, args):
    engine = active_engine(conf)
    return _with_lock(lambda: install_proxy(conf, engine, current_layout(conf, engine),
                                            hostname=args['hostname']))


def op_proxy_remove(conf, args):
    def remove():
        for path in (P(SITE_FILE), P(SNIPPET_FILE)):
            if not _ours(path):
                raise HelperError(f'{path} was not written by clientst0r; refusing to remove it')
        if not _link_ok(P(SITE_LINK)):
            raise HelperError(f'{SITE_LINK} is not this helper\'s link')
        before_site, before_snip = _read(P(SITE_FILE)), _read(P(SNIPPET_FILE))
        had_link = os.path.lexists(P(SITE_LINK))
        _write_proxy_files(None, EMPTY_SNIPPET)
        ok, detail = nginx_test()
        if not ok:
            if before_snip is not None:
                write_atomic(P(SNIPPET_FILE), before_snip, 0o644)
            if before_site is not None:
                write_atomic(P(SITE_FILE), before_site, 0o644)
                if had_link and not os.path.lexists(P(SITE_LINK)):
                    os.symlink(P(SITE_FILE), P(SITE_LINK))
            raise HelperError('nginx -t failed after removing the office configuration; it was '
                              'put back: ' + detail)
        run(['systemctl', 'reload', 'nginx'], timeout=60)
        st = dict(proxy_state(), installed=False, removed_at=now_iso())
        write_atomic(P(PROXY_STATE_FILE), json.dumps(st, indent=1, sort_keys=True), 0o600)
        history({'event': 'proxy-remove'})
        return {'removed': True, 'kept': SNIPPET_FILE + ' (empty, so an include stays valid)'}
    return _with_lock(remove)


def op_callback_check(conf, args):
    """From inside the running container, the editor -> clientst0r path:
    TCP to the callback destination and a verified TLS handshake for
    clientst0r's host name (the container's own trust store)."""
    engine = active_engine(conf)
    st = container_state(engine)
    if not st.get('running'):
        raise HelperError('the editor container is not running')
    host = conf['clientstor_host']
    if engine == 'collabora':
        argv = ['exec', ENGINES[engine]['container'], 'openssl', 's_client', '-connect', f'{host}:443',
                '-servername', host, '-verify_hostname', host, '-verify_return_error', '-brief']
    else:
        argv = ['exec', CONTAINER, 'curl', '-sS', '-o', '/dev/null', '-w', '%{http_code}',
                '--max-time', '15', f'https://{host}/health/']
    r = docker(*argv, timeout=40)
    text = redact(((r.stdout or '') + ' ' + (r.stderr or '')).strip())[-400:]
    return {'ok': r.returncode == 0, 'engine': engine, 'target': f'{conf["callback_target"]}:443',
            'route': conf['callback_route'], 'detail': text}


