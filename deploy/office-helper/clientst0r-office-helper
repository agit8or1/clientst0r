def _csv(raw, key, allowed, default):
    value = raw.get(key, default)
    items = [x.strip() for x in value.split(',') if x.strip()]
    if not items or len(set(items)) != len(items) or any(x not in allowed for x in items):
        raise HelperError(f'{CONF_PATH}: {key} must be a comma-separated list of '
                          f'{", ".join(allowed)}')
    return tuple(items)


def _limits(raw, conf, key_mem, key_cpus, default_mem, default_cpus, minimum, label):
    try:
        mem = int(raw.get(key_mem, str(default_mem)))
        cpus = float(raw.get(key_cpus, str(default_cpus)))
    except ValueError:
        raise HelperError(f'{CONF_PATH}: {key_cpus} and {key_mem} must be numbers')
    if mem < minimum:
        raise HelperError(f'{CONF_PATH}: {key_mem} must be at least {minimum} ({label})')
    total = _meminfo().get('MemTotal', 0)
    if total and mem + conf['reserve_mb'] > total:
        raise HelperError(f'{CONF_PATH}: {key_mem} {mem} + RESERVE_MB {conf["reserve_mb"]} '
                          f'is more than this host\'s {total} MB')
    ncpu = _cpu_count()
    if not (0.5 <= cpus <= max(0.5, ncpu - 1)) or round(cpus, 2) != cpus:
        raise HelperError(f'{CONF_PATH}: {key_cpus} must be 0.5-{max(0.5, ncpu - 1)} (one core stays '
                          'for clientst0r), at most two decimals')
    return mem, cpus


def _port(raw, key, default):
    try:
        port = int(raw.get(key, str(default)))
    except ValueError:
        raise HelperError(f'{CONF_PATH}: {key} must be a number')
    if not 1024 <= port <= 65535:
        raise HelperError(f'{CONF_PATH}: {key} must be 1024-65535')
    return port


def validate_config(raw):
    unknown = sorted(set(raw) - KNOWN_KEYS)
    if unknown:
        raise HelperError(f'{CONF_PATH}: unknown setting(s) {", ".join(unknown)}')
    c = {}

    def need(key, pattern, label):
        value = raw.get(key, '')
        if not pattern.match(value):
            raise HelperError(f'{CONF_PATH}: {key} is missing or not {label}')
        return value

    c['deployment_id'] = need('DEPLOYMENT_ID', ID_RE, 'a short lower-case id')
    c['app_user'] = need('APP_USER', USER_RE, 'a user name')
    if c['app_user'] == 'root':
        raise HelperError(f'{CONF_PATH}: APP_USER must not be root')
    c['engines'] = _csv(raw, 'ENGINES', ENGINE_IDS, 'onlyoffice')
    c['layouts'] = _csv(raw, 'PROXY_LAYOUTS', LAYOUTS, 'dedicated')
    if 'same-host' in c['layouts'] and 'collabora' not in c['engines']:
        raise HelperError(f'{CONF_PATH}: PROXY_LAYOUTS same-host is supported for Collabora only '
                          '(ENGINES must list collabora)')
    if c['layouts'] == ('same-host',) and 'onlyoffice' in c['engines']:
        raise HelperError(f'{CONF_PATH}: ONLYOFFICE needs a dedicated host name: add dedicated to '
                          'PROXY_LAYOUTS or remove onlyoffice from ENGINES')

    url = raw.get('CLIENTSTOR_URL', '')
    m = re.match(r'^https://([a-z0-9.-]+)(:([0-9]{2,5}))?/?$', url.lower())
    if not m or not HOST_RE.match(m.group(1)):
        raise HelperError(f'{CONF_PATH}: CLIENTSTOR_URL must be https://<clientst0r host name>/ '
                          '(no path, no IP address)')
    c['clientstor_host'] = m.group(1)
    c['clientstor_port'] = int(m.group(3) or 443)
    if c['clientstor_port'] != 443:
        # The firewall opens exactly one destination on 443 to the container.
        raise HelperError(f'{CONF_PATH}: CLIENTSTOR_URL must use port 443')
    c['clientstor_url'] = f'https://{c["clientstor_host"]}/'

    host = raw.get('OFFICE_HOSTNAME', '').lower()
    if 'dedicated' in c['layouts'] or host:
        if not HOST_RE.match(host):
            raise HelperError(f'{CONF_PATH}: OFFICE_HOSTNAME is missing or not a DNS host name')
        if host == c['clientstor_host']:
            raise HelperError(f'{CONF_PATH}: OFFICE_HOSTNAME must differ from clientst0r\'s host name '
                              '(the editor gets its own origin)')
    c['office_hostname'] = host

    c['bind_port'] = _port(raw, 'BIND_PORT', 8090)
    c['cool_bind_port'] = _port(raw, 'COLLABORA_BIND_PORT', 9981)
    if c['cool_bind_port'] == c['bind_port']:
        raise HelperError(f'{CONF_PATH}: COLLABORA_BIND_PORT must differ from BIND_PORT')

    c['edition'] = raw.get('EDITION', 'community')
    if c['edition'] not in ('community', 'enterprise'):
        raise HelperError(f'{CONF_PATH}: EDITION must be community or enterprise')

    try:
        c['reserve_mb'] = int(raw.get('RESERVE_MB', str(DEFAULT_RESERVE_MB)))
    except ValueError:
        raise HelperError(f'{CONF_PATH}: CPUS, MEMORY_MB and RESERVE_MB must be numbers')
    if c['reserve_mb'] < 1024:
        raise HelperError(f'{CONF_PATH}: RESERVE_MB must leave at least 1024 MB for clientst0r')
    if 'onlyoffice' in c['engines']:
        c['memory_mb'], c['cpus'] = _limits(raw, c, 'MEMORY_MB', 'CPUS', VENDOR_RECOMMENDED_MEMORY_MB, 2,
                                            VENDOR_MIN_MEMORY_MB, 'ONLYOFFICE\'s published minimum')
    else:
        c['memory_mb'], c['cpus'] = 0, 0.0
    if 'collabora' in c['engines']:
        c['cool_memory_mb'], c['cool_cpus'] = _limits(
            raw, c, 'COLLABORA_MEMORY_MB', 'COLLABORA_CPUS', COOL_DEFAULT_MEMORY_MB, COOL_DEFAULT_CPUS,
            COOL_MIN_MEMORY_MB, 'clientst0r\'s floor for CODE')
    else:
        c['cool_memory_mb'], c['cool_cpus'] = 0, 0.0

    try:
        net = ipaddress.ip_network(raw.get('NETWORK_SUBNET', '172.31.250.0/28'), strict=True)
    except ValueError:
        raise HelperError(f'{CONF_PATH}: NETWORK_SUBNET is not a network such as 172.31.250.0/28')
    if net.version != 4 or not net.is_private or not 24 <= net.prefixlen <= 29 \
            or net.overlaps(ipaddress.ip_network('169.254.0.0/16')) \
            or net.overlaps(ipaddress.ip_network('127.0.0.0/8')):
        raise HelperError(f'{CONF_PATH}: NETWORK_SUBNET must be a private IPv4 /24-/29')
    c['subnet'] = str(net)
    c['gateway'] = str(next(net.hosts()))

    for key, name in (('ALLOW_UNTESTED_RELEASES', 'allow_untested'), ('PRIVATE_CA', 'private_ca'),
                      ('MAINTENANCE_UPDATES', 'maintenance_updates')):
        value = raw.get(key, 'no')
        if value not in ('yes', 'no'):
            raise HelperError(f'{CONF_PATH}: {key} must be yes or no')
        c[name] = value == 'yes'

    # Reverse proxy. upstream = TLS is terminated on another device in front
    # of this server, which forwards plain HTTP to this server's Nginx on 80.
    c['proxy_tls'] = raw.get('PROXY_TLS', 'local-cert')
    if c['proxy_tls'] not in PROXY_TLS_MODES:
        raise HelperError(f'{CONF_PATH}: PROXY_TLS must be one of {", ".join(PROXY_TLS_MODES)}')
    for key, name in (('PROXY_CERT_FILE', 'cert_file'), ('PROXY_KEY_FILE', 'key_file')):
        value = raw.get(key, '')
        if value and (not CERT_PATH_RE.match(value) or '..' in value.split('/')):
            raise HelperError(f'{CONF_PATH}: {key} must be a file under /etc/ssl/, '
                              '/etc/letsencrypt/live/ or /etc/clientst0r/office/tls/')
        c[name] = value
    try:
        c['max_body_mb'] = int(raw.get('PROXY_MAX_BODY_MB', '100'))
    except ValueError:
        raise HelperError(f'{CONF_PATH}: PROXY_MAX_BODY_MB must be a number')
    if not 1 <= c['max_body_mb'] <= 1024:
        raise HelperError(f'{CONF_PATH}: PROXY_MAX_BODY_MB must be 1-1024')

    # How the container reaches clientst0r (callbacks, WOPI, downloads).
    # gateway  = this host's Nginx on the bridge gateway:443 (needs local TLS)
    # upstream = the TLS-terminating device in front of this server, at one
    #            fixed IPv4 address, port 443 (PROXY_TLS=upstream setups)
    c['callback_route'] = raw.get('CALLBACK_ROUTE', 'gateway')
    if c['callback_route'] not in ('gateway', 'upstream'):
        raise HelperError(f'{CONF_PATH}: CALLBACK_ROUTE must be gateway or upstream')
    c['upstream_ip'] = ''
    if c['callback_route'] == 'upstream':
        try:
            ip = ipaddress.ip_address(raw.get('CALLBACK_UPSTREAM_IP', ''))
        except ValueError:
            raise HelperError(f'{CONF_PATH}: CALLBACK_ROUTE=upstream needs CALLBACK_UPSTREAM_IP '
                              '(the IPv4 address of the TLS proxy in front of this server)')
        if ip.version != 4 or ip.is_loopback or ip.is_link_local or ip.is_multicast \
                or ip.is_unspecified or ip in net \
                or ip in ipaddress.ip_network('100.100.100.200/32'):
            raise HelperError(f'{CONF_PATH}: CALLBACK_UPSTREAM_IP must be a unicast IPv4 address '
                              'outside loopback, link-local and NETWORK_SUBNET')
        c['upstream_ip'] = str(ip)
    c['callback_target'] = c['upstream_ip'] or c['gateway']

    try:
        c['app_uid'] = pwd.getpwnam(c['app_user']).pw_uid
    except KeyError:
        if not TEST_MODE:
            raise HelperError(f'{CONF_PATH}: APP_USER {c["app_user"]} does not exist')
        c['app_uid'] = TEST_UID
    if TEST_MODE:
        c['app_uid'] = TEST_UID
    return c


def engine_limits(conf, engine):
    if engine == 'collabora':
        return conf['cool_memory_mb'], conf['cool_cpus'], conf['cool_bind_port']
    return conf['memory_mb'], conf['cpus'], conf['bind_port']


def proxy_state():
    return read_json(P(PROXY_STATE_FILE), {}) or {}


def current_layout(conf, engine=None):
    engine = engine or active_engine(conf)
    allowed = [x for x in conf['layouts'] if x in ENGINES[engine]['layouts']]
    chosen = proxy_state().get('layout')
    if chosen in allowed:
        return chosen
    return allowed[0] if allowed else 'dedicated'


def public_host(conf, layout):
    return conf['clientstor_host'] if layout == 'same-host' else conf['office_hostname']


def active_engine(conf):
    """The engine installed now (or the one to install by default)."""
    inst = installed()
    if inst.get('release') and inst.get('state') != 'uninstalled':
        return inst.get('engine') or 'onlyoffice'
    if inst.get('engine') in conf['engines']:
        return inst['engine']
    return conf['engines'][0]


def addresses(conf, engine=None):
    engine = engine or active_engine(conf)
    layout = current_layout(conf, engine)
    _mem, _cpus, port = engine_limits(conf, engine)
    return {'engine': engine, 'layout': layout, 'browser_url': f'https://{public_host(conf, layout)}/',
            'internal_url': f'http://127.0.0.1:{port}/'}


def public_config(c):
    """What status may show the app: no secrets, no paths."""
    out = {k: c[k] for k in ('deployment_id', 'office_hostname', 'clientstor_url', 'bind_port',
                             'edition', 'cpus', 'memory_mb', 'reserve_mb', 'subnet',
                             'allow_untested', 'private_ca', 'maintenance_updates', 'engines',
                             'layouts', 'proxy_tls', 'max_body_mb', 'callback_route',
                             'cool_bind_port', 'cool_memory_mb', 'cool_cpus')}
    out['engines'], out['layouts'] = list(c['engines']), list(c['layouts'])
    addr = addresses(c)
    out.update(engine=addr['engine'], layout=addr['layout'], browser_url=addr['browser_url'],
               internal_url=addr['internal_url'])
    out['engine_layouts'] = {e: [x for x in c['layouts'] if x in ENGINES[e]['layouts']]
                             for e in c['engines']}
    out['engine_memory_mb'], out['engine_cpus'], _port = engine_limits(c, addr['engine'])
    return out


# ---------------------------------------------------------------------------
# releases
# ---------------------------------------------------------------------------

def release(release_id):
    for r in ALL_RELEASES:
        if r['id'] == release_id:
            return r
    return None


def engine_edition(conf, engine):
    return 'code' if engine == 'collabora' else conf['edition']


def release_problem(r, conf):
    if r is None:
        return 'not in the tested release list'
    engine = r.get('engine', 'onlyoffice')
    if not DIGEST_RE.match(r['digest']) or r['digest'] == PLACEHOLDER_DIGEST:
        return 'has no pinned image digest (placeholder); this release cannot be installed'
    if not re.match(ENGINES[engine]['image_re'], r['image']):
        return 'names an image outside the official repositories'
    if engine not in conf.get('engines', ('onlyoffice',)):
        return f'is a {ENGINES[engine]["label"]} release; ENGINES does not list {engine}'
    if r['edition'] != engine_edition(conf, engine):
        return f'is the {r["edition"]} edition; this deployment is configured for {conf["edition"]}'
    if not r['tested'] and not conf['allow_untested']:
        return ('has not passed clientst0r\'s live verification yet; set '
                'ALLOW_UNTESTED_RELEASES=yes in office-service.conf only on a test VM')
    return ''


def version_key(r):
    return tuple(int(x) for x in r['version'].split('.'))


def engine_releases(engine):
    return [r for r in ALL_RELEASES if r['engine'] == engine]


def default_release(conf, engine=None):
    engine = engine or active_engine(conf)
    usable = [r for r in engine_releases(engine) if not release_problem(r, conf)]
    return max(usable, key=version_key) if usable else None


def image_ref(r):
    return f'{r["image"]}@{r["digest"]}'


