    return f'{STATE_DIR}/installed-{engine}.json'


def _ensure_proxy(conf, engine, progress):
    """When this helper manages the Nginx files and they were written for
    another engine (an engine switch), rewrite them for this one."""
    ps = proxy_state()
    if ps.get('installed') and ps.get('engine') != engine:
        install_proxy(conf, engine, current_layout(conf, engine), progress)


def op_install(conf, args, progress):
    inst = installed()
    present = bool(inst.get('release')) and inst.get('state') != 'uninstalled'
    current = (inst.get('engine') or 'onlyoffice') if inst.get('release') else None
    engine = args.get('engine') or current or conf['engines'][0]
    if engine not in conf['engines']:
        raise HelperError(f'{engine} is not listed in ENGINES in {CONF_PATH}')
    if present and current != engine:
        raise HelperError(f'{ENGINES[current]["label"]} is installed. Uninstall it first (Switch engine '
                          'drains it, uninstalls it and installs the other; documents stay in clientst0r).')
    cap = capacity(conf, engine)
    if cap['verdict'] == 'fail':
        raise HelperError('refused, the editor would starve this server: ' + '; '.join(
            c['detail'] for c in cap['checks'] if c['status'] == 'fail'))
    ok, _v, detail = docker_available()
    if not ok:
        raise HelperError(f'Docker is not usable: {detail}')
    if current and current != engine:
        # Switching engines: keep the other engine's record (its release and
        # backups) for a later switch back; start from this engine's own.
        write_atomic(P(_engine_record_path(current)), json.dumps(inst, indent=1, sort_keys=True), 0o600)
        inst = read_json(P(_engine_record_path(engine)), {}) or {}
    reuse = bool(inst.get('release')) and (inst.get('engine') or 'onlyoffice') == engine
    r = release(inst['release']) if reuse else default_release(conf, engine)
    if r is None:
        raise HelperError('no installable release: ' + '; '.join(
            f'{x["id"]} {release_problem(x, conf)}' for x in engine_releases(engine)))
    problem = release_problem(r, conf) if not reuse else ''
    if problem:
        raise HelperError(f'release {r["id"]} {problem}')
    pull(r, progress)
    save_installed(dict(inst, state='installing', engine=engine, release=r['id'], version=r['version'],
                        digest=r['digest'], edition=r['edition'],
                        installed_at=inst.get('installed_at') if reuse else now_iso()))
    _up(conf, r, progress)
    if not wait_healthy(conf, engine, progress):
        save_installed(dict(installed(), state='unhealthy'))
        raise HelperError('the editor did not become healthy; see the logs')
    save_installed(dict(installed(), state='installed'))
    _ensure_proxy(conf, engine, progress)
    history({'event': 'install', 'release': r['id'], 'engine': engine})
    return {'release': r['id'], 'engine': engine, 'healthy': True}


def _require_installed():
    inst = installed()
    if not inst.get('release') or inst.get('state') == 'uninstalled':
        raise HelperError('the editor is not installed')
    r = release(inst['release'])
    if r is None:
        raise HelperError(f'installed release {inst["release"]} is no longer in the release list')
    return inst, r


def op_start(conf, args, progress):
    inst, r = _require_installed()
    if not os.path.exists(P(ENGINES[r['engine']]['compose_file'])):
        write_compose(conf, r)
    apply_firewall(conf)
    compose(r['engine'], 'up', '--detach', '--pull', 'never', timeout=600)
    if not wait_healthy(conf, r['engine'], progress):
        raise HelperError('the editor started but did not become healthy; see the logs')
    return {'healthy': True}


def op_stop(conf, args, progress):
    _inst, r = _require_installed()
    prepare_for_shutdown(r['engine'], progress)
    progress('stopping the editor')
    stop_container(r['engine'])
    return {'stopped': True}


def op_restart(conf, args, progress):
    op_stop(conf, args, progress)
    return op_start(conf, args, progress)


def op_update(conf, args, progress):
    inst, current = _require_installed()
    engine = current['engine']
    target = release(args['release'])
    problem = release_problem(target, conf)
    if problem:
        raise HelperError(f'release {args["release"]} {problem}')
    if target['engine'] != engine:
        raise HelperError('that release is for the other engine: use Switch engine')
    if target['id'] == current['id']:
        st = container_state(engine)
        if st.get('running') and st.get('release_label') == target['id']:
            return {'release': target['id'], 'changed': False}
    if version_key(target) < version_key(current):
        raise HelperError('that is an older release: use rollback, which restores the matching backup')
    pull(target, progress)                      # before any downtime
    prepare_for_shutdown(engine, progress)
    progress('stopping the editor')
    stop_container(engine, check=False)
    backup = take_backup(conf, current['id'], 'pre-update', progress)
    save_installed(dict(inst, state='updating', pending_release=target['id']))
    try:
        _up(conf, target, progress)
        healthy = wait_healthy(conf, engine, progress)
    except HelperError:
        healthy = False
    if healthy:
        save_installed({'state': 'installed', 'engine': engine, 'release': target['id'],
                        'version': target['version'], 'digest': target['digest'],
                        'edition': target['edition'], 'installed_at': now_iso(),
                        'previous_release': current['id'], 'previous_backup': backup['id']})
        prune_backups({backup['id']})
        history({'event': 'update', 'from': current['id'], 'to': target['id'], 'backup': backup['id']})
        return {'release': target['id'], 'previous_release': current['id'], 'backup': backup['id'],
                'changed': True}
    # Never became healthy, so nobody can have edited with it: put the old
    # release back with the data exactly as it was before the update.
    progress('the new release did not become healthy: restoring the previous release automatically')
    compose(engine, 'down', '--timeout', '60', timeout=180, check=False)
    restore_backup(backup, progress)
    _up(conf, current, progress)
    back = wait_healthy(conf, engine, progress)
    save_installed(dict(inst, state='installed' if back else 'unhealthy'))
    history({'event': 'update_failed', 'from': current['id'], 'to': target['id'],
             'restored': back})
    raise HelperError(f'update to {target["id"]} failed health checks; '
                      f'{"the previous release is running again" if back else "the previous release did not come back either: see the logs"}')


def op_rollback(conf, args, progress):
    inst, current = _require_installed()
    engine = current['engine']
    prev_id, backup_id = inst.get('previous_release'), inst.get('previous_backup')
    if not prev_id or not backup_id:
        raise HelperError('nothing to roll back to: no update with a backup was recorded')
    prev = release(prev_id)
    if prev is None or prev['engine'] != engine:
        raise HelperError(f'release {prev_id} is no longer in the release list')
    manifest = next((b for b in list_backups() if b['id'] == backup_id), None)
    if manifest is None or manifest['release'] != prev_id or manifest['digest'] != prev['digest']:
        raise HelperError(f'backup {backup_id} is missing or was not taken from {prev_id}; '
                          'rolling back without it could break the editor\'s data')
    pull(prev, progress)
    prepare_for_shutdown(engine, progress)
    stop_container(engine, check=False)
    # The editor data since the update is kept, never overwritten blindly.
    safety = take_backup(conf, current['id'], 'pre-rollback', progress)
    compose(engine, 'down', '--timeout', '60', timeout=180, check=False)
    restore_backup(manifest, progress)
    _up(conf, prev, progress)
    if not wait_healthy(conf, engine, progress):
        save_installed(dict(inst, state='unhealthy'))
        raise HelperError(f'rolled back to {prev_id} but it did not become healthy; the data from '
                          f'before the rollback is kept in backup {safety["id"]}')
    save_installed({'state': 'installed', 'engine': engine, 'release': prev['id'],
                    'version': prev['version'], 'digest': prev['digest'], 'edition': prev['edition'],
                    'installed_at': now_iso(), 'previous_release': None, 'previous_backup': None,
                    'rolled_back_from': current['id'], 'pre_rollback_backup': safety['id']})
    prune_backups({safety['id'], manifest['id']})
    history({'event': 'rollback', 'from': current['id'], 'to': prev['id'], 'kept': safety['id']})
    return {'release': prev['id'], 'kept_backup': safety['id']}


def op_uninstall(conf, args, progress):
    inst = installed()
    engine = inst.get('engine') or ('onlyoffice' if inst.get('release') else active_engine(conf))
    if os.path.exists(P(ENGINES[engine]['compose_file'])):
        prepare_for_shutdown(engine, progress)
        progress('removing the editor container (documents and editor data are kept)')
        t = ENGINES[engine]['stop_timeout']
        compose(engine, 'down', '--timeout', str(t), timeout=t + 60, check=False)
    else:
        docker('rm', '--force', ENGINES[engine]['container'], timeout=60)
    save_installed(dict(inst, state='uninstalled', engine=engine))
    history({'event': 'uninstall', 'engine': engine})
    return {'uninstalled': True, 'engine': engine, 'data_kept': BASE_DIR, 'secrets_kept': SECRETS_DIR}


def op_set_layout(conf, args, progress):
    """Switch between the dedicated host name and the same-host layout
    without reinstalling: proxy files first (tested, restored on failure),
    then the container is re-created with the new server name. The app
    drains editing sessions before it asks for this."""
    layout = args['layout']
    engine = active_engine(conf)
    if layout not in conf['layouts']:
        raise HelperError(f'layout {layout} is not allowed by PROXY_LAYOUTS in {CONF_PATH}')
    if layout not in ENGINES[engine]['layouts']:
        raise HelperError(f'{ENGINES[engine]["label"]} supports only a dedicated host name')
    old = current_layout(conf, engine)
    ps = proxy_state()
    if ps.get('installed'):
        install_proxy(conf, engine, layout, progress)
    else:
        write_atomic(P(PROXY_STATE_FILE), json.dumps(dict(ps, layout=layout), indent=1, sort_keys=True),
                     0o600)
    inst = installed()
    recreated = False
    if inst.get('release') and inst.get('state') != 'uninstalled' and engine == 'collabora':
        r = release(inst['release'])
        if r is not None:
            st = container_state(engine)
            write_compose(conf, r)
            if st.get('exists'):
                progress(f're-creating the editor for the {layout} layout (data is kept)')
                compose(engine, 'up', '--detach', '--pull', 'never', timeout=600)
                recreated = True
                if not wait_healthy(conf, engine, progress):
                    raise HelperError(f'the editor did not become healthy with the {layout} layout; '
                                      f'switch back to {old} or see the logs')
    history({'event': 'set-layout', 'from': old, 'to': layout})
    return {'layout': layout, 'previous_layout': old, 'recreated': recreated,
            'proxy_managed': bool(ps.get('installed')), **addresses(conf, engine)}


def op_purge(conf, args, progress):
    if args.get('confirm') != conf['deployment_id']:
        raise HelperError('purge needs --confirm <DEPLOYMENT_ID>')
    if any(container_state(e).get('exists') for e in ENGINE_IDS) \
            or installed().get('state') not in (None, 'uninstalled'):
        raise HelperError('uninstall first; purge only removes the data of an uninstalled editor')
    for d in (DATA_DIR, COOL_DIR, BACKUP_DIR, COMPOSE_DIR, STATE_DIR, SECRETS_DIR):
        shutil.rmtree(P(d), ignore_errors=True)
    for r in ALL_RELEASES:
        docker('image', 'rm', image_ref(r), timeout=120)
    run(['nft', 'delete', 'table', 'inet', NFT_TABLE], timeout=30)
    return {'purged': True}


OPERATIONS = {
    'preflight': op_preflight, 'status': op_status, 'releases': op_releases, 'logs': op_logs,
    'secret': op_secret, 'install': op_install, 'start': op_start, 'stop': op_stop,
    'restart': op_restart, 'update': op_update, 'rollback': op_rollback,
    'uninstall': op_uninstall, 'purge': op_purge, 'set-layout': op_set_layout,
    'proxy-status': op_proxy_status, 'proxy-install': op_proxy_install,
    'proxy-remove': op_proxy_remove, 'callback-check': op_callback_check,
}


# ---------------------------------------------------------------------------
# request validation
# ---------------------------------------------------------------------------

def validate_request(req, *, cli=False):
    """(op, args) for a request, or HelperError. Nothing outside this
    grammar is accepted, and no string the app sends reaches a command line
    or a file except values that equal a fixed choice (a release id from the
    lists, an engine or layout name) or the configured host name."""
    if not isinstance(req, dict) or set(req) - {'op', 'args'}:
        raise HelperError('a request is {"op": ..., "args": {...}}')
    op = req.get('op')
    args = req.get('args', {})
    if not isinstance(op, str) or not isinstance(args, dict):
        raise HelperError('bad request')
    allowed = SOCKET_OPS + (('purge',) if cli else ())
    if op not in allowed:
        raise HelperError(f'unknown operation {op[:40]!r}' if op not in CLI_ONLY_OPS
                          else f'{op} is only available from a root shell (clientst0r-office-helper cli {op})')
    if op == 'update':
        if set(args) != {'release'} or not isinstance(args['release'], str) \
                or not RELEASE_RE.match(args['release']) or release(args['release']) is None:
            raise HelperError('update needs {"release": "<id from the release list>"}')
        return op, {'release': args['release']}
    if op in ('install', 'preflight'):
        if set(args) - {'engine'}:
            raise HelperError(f'{op} takes only "engine"')
        if 'engine' in args:
            if not isinstance(args['engine'], str) or args['engine'] not in ENGINE_IDS:
                raise HelperError('engine must be "onlyoffice" or "collabora"')
            return op, {'engine': args['engine']}
        return op, {}
    if op == 'set-layout':
        if set(args) != {'layout'} or not isinstance(args['layout'], str) \
                or args['layout'] not in LAYOUTS:
            raise HelperError('set-layout needs {"layout": "dedicated" | "same-host"}')
        return op, {'layout': args['layout']}
    if op == 'proxy-install':
        host = args.get('hostname')
        if set(args) != {'hostname'} or not isinstance(host, str) or len(host) > 253 \
                or not HOST_RE.match(host):
            raise HelperError('proxy-install needs {"hostname": "<the configured host name>"}')
        return op, {'hostname': host}
    if op == 'logs':
        if set(args) - {'lines'}:
            raise HelperError('logs takes only "lines"')
        lines = args.get('lines', 200)
        if not isinstance(lines, int) or isinstance(lines, bool) or not 1 <= lines <= MAX_LOG_LINES:
            raise HelperError(f'lines must be 1-{MAX_LOG_LINES}')
        return op, {'lines': lines}
    if op == 'purge':
        if set(args) != {'confirm'} or not isinstance(args['confirm'], str) or not ID_RE.match(args['confirm']):
            raise HelperError('purge needs --confirm <DEPLOYMENT_ID>')
        return op, {'confirm': args['confirm']}
    if args:
        raise HelperError(f'{op} takes no arguments')
    return op, {}


# ---------------------------------------------------------------------------
# execution
# ---------------------------------------------------------------------------

def run_async(conf, op, args, reply):
    """Take the lock, journal the operation, reply 'accepted', then run it
    to the end in this process (the caller may disconnect)."""
    reconcile_journal()
    fd = acquire_lock()
    if fd is None:
        j = journal()
        reply({'ok': False, 'busy': True,
               'error': f'another operation is running ({j.get("op", "?")}, {j.get("step", "")})'})
        return 0
    op_id = f'{datetime.datetime.now(datetime.timezone.utc):%Y%m%dT%H%M%S}-{secrets.token_hex(3)}'
    j = {'id': op_id, 'op': op, 'args': args, 'state': 'running', 'step': 'starting',
         'started_at': now_iso(), 'finished_at': None, 'error': '', 'result': None,
         'pid': os.getpid(), 'boot_id': _boot_id()}
    write_journal(j)
    _log(f'{op} {json.dumps(args)} accepted ({op_id})')
    reply({'ok': True, 'accepted': True, 'operation': {'id': op_id, 'op': op, 'state': 'running'}})

    def progress(step):
        j['step'] = redact(step)[:300]
        write_journal(j)

    try:
        result = OPERATIONS[op](conf, args, progress)
        j.update(state='succeeded', result=result, finished_at=now_iso(), step='done')
    except HelperError as e:
        j.update(state='failed', error=redact(str(e))[:1000], finished_at=now_iso())
    except Exception as e:      # report, never leave "running" behind
        j.update(state='failed', error=f'internal error: {type(e).__name__}: {redact(str(e))[:300]}',
                 finished_at=now_iso())
    write_journal(j)
    history({'event': 'operation', 'op': op, 'id': op_id, 'state': j['state']})
    _log(f'{op} {op_id} {j["state"]} {j.get("error", "")}')
    os.close(fd)
    return 0 if j['state'] == 'succeeded' else 1


def peer_uid(sock):
    creds = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
    _pid, uid, _gid = struct.unpack('3i', creds)
    return uid


def serve():
    """One request on the systemd-passed connection (fd 0)."""
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    sock = socket.socket(fileno=os.dup(0))
    out = {'sent': False}

    def reply(obj):
        if out['sent']:
            return
        out['sent'] = True
        try:
            sock.sendall((json.dumps(obj) + '\n').encode())
            sock.shutdown(socket.SHUT_WR)
            sock.settimeout(1)
            while sock.recv(4096):      # discard the rest of an oversized request
                pass
        except OSError:
            pass
        sock.close()
        for fd in (0, 1):       # release the connection; long work continues
            try:
                os.close(fd)
            except OSError:
                pass

    try:
        # Read the (small, bounded) request first so that any refusal below
        # is a clean reply rather than a reset connection.
        sock.settimeout(10)
        data = b''
        while not data.endswith(b'\n'):
            chunk = sock.recv(1024)
            if not chunk:
                break
            data += chunk
            if len(data) > MAX_REQUEST:
                raise HelperError('request too large')
        conf = load_config()
        uid = peer_uid(sock)
        if uid not in (0, conf['app_uid']):
            _log(f'refused connection from uid {uid}')
            reply({'ok': False, 'error': 'not allowed'})
            return 1
        try:
            req = json.loads(data.decode('utf-8'))
        except (ValueError, UnicodeDecodeError):
            raise HelperError('the request is not JSON')
        op, args = validate_request(req)
        if op in ASYNC_OPS:
            return run_async(conf, op, args, reply)
        result = OPERATIONS[op](conf, args)
        reply({'ok': True, 'result': result})
        return 0
    except HelperError as e:
        _log(f'refused: {e}')
        reply({'ok': False, 'error': redact(str(e))[:1000]})
        return 1
    except Exception as e:
        reply({'ok': False, 'error': f'internal error: {type(e).__name__}'})
        return 1


def cli(argv):
    if not TEST_MODE and os.geteuid() != 0:
        print('clientst0r-office-helper cli must run as root', file=sys.stderr)
        return 2
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    op, rest = argv[0], argv[1:]
    try:
        conf = load_config()
        if op == 'apply-firewall':
            print(apply_firewall(conf))
            return 0
        args = {}
        if op == 'update' and len(rest) == 1:
            args = {'release': rest[0]}
        elif op in ('install', 'preflight') and len(rest) == 1:
            args = {'engine': rest[0]}
        elif op == 'set-layout' and len(rest) == 1:
            args = {'layout': rest[0]}
        elif op == 'proxy-install' and len(rest) == 1:
            args = {'hostname': rest[0].lower()}
        elif op == 'logs' and len(rest) == 1 and rest[0].isdigit():
            args = {'lines': int(rest[0])}
        elif op == 'purge' and len(rest) == 2 and rest[0] == '--confirm':
            args = {'confirm': rest[1]}
        elif rest:
            raise HelperError(f'unexpected arguments for {op}')
        op, args = validate_request({'op': op, 'args': args}, cli=True)
        if op in ASYNC_OPS:
            def reply(obj):
                print(json.dumps(obj))
            rc = run_async(conf, op, args, reply)
            print(json.dumps(journal(), indent=1))
            return rc
        result = OPERATIONS[op](conf, args) if op != 'purge' else \
            OPERATIONS[op](conf, args, lambda s: print(s))
        print(json.dumps(result, indent=1))
        return 0
    except HelperError as e:
        print(f'clientst0r-office-helper: {e}', file=sys.stderr)
        return 1


def main(argv):
    _enable_test_mode()
    os.umask(0o077)
    if argv[:1] == ['serve']:
        if not TEST_MODE and os.geteuid() != 0:
            return 2
        return serve()
    if argv[:1] == ['cli']:
        return cli(argv[1:])
    if argv[:1] == ['version']:
        print(HELPER_VERSION)
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
