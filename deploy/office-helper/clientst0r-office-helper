def _alnum_secret(n=48):
    alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
    return ''.join(secrets.choice(alphabet) for _ in range(n))


def ensure_secrets():
    """Generate the JWT and secure-link secrets once (persistent, unique to
    this deployment). Never regenerated: sessions and the app depend on them."""
    os.makedirs(P(SECRETS_DIR), mode=0o700, exist_ok=True)
    os.chmod(P(SECRETS_DIR), 0o700)
    for path in (JWT_FILE, LINK_FILE):
        if not os.path.exists(P(path)):
            write_atomic(P(path), _alnum_secret() + '\n', 0o600)
    jwt = read_secret(JWT_FILE)
    link = read_secret(LINK_FILE)
    write_atomic(P(ENV_FILE), f'JWT_SECRET={jwt}\nSECURE_LINK_SECRET={link}\n', 0o600)


COOL_UID = 1001     # the image's "cool" user (Dockerfile: usermod -u 1001 cool)


def ensure_cool_secrets():
    """Collabora: an admin password (the image wants one; the admin console
    is switched off) and the WOPI proof key, both generated here once and
    kept root-owned. The proof key is mounted read-only so it survives
    container re-creation: clientst0r verifies X-WOPI-Proof against it."""
    os.makedirs(P(SECRETS_DIR), mode=0o700, exist_ok=True)
    os.chmod(P(SECRETS_DIR), 0o700)
    if not os.path.exists(P(COOL_ADMIN_FILE)):
        write_atomic(P(COOL_ADMIN_FILE), _alnum_secret() + '\n', 0o600)
    password = read_secret(COOL_ADMIN_FILE)
    write_atomic(P(COOL_ENV_FILE), f'username=clientst0r-admin\npassword={password}\n', 0o600)
    os.makedirs(P(COOL_DIR), mode=0o711, exist_ok=True)
    key = P(COOL_PROOF_KEY)
    if not os.path.exists(key):
        tmp = key + '.new'
        if os.path.exists(tmp):
            os.unlink(tmp)
        run(['openssl', 'genrsa', '-traditional', '-out', tmp, '2048'], timeout=120, check=True)
        os.replace(tmp, key)
    os.chmod(key, 0o400)
    if not TEST_MODE:
        os.chown(key, COOL_UID, COOL_UID)


def read_secret(path):
    _check_trusted(P(path), secret=True)
    with open(P(path), encoding='ascii') as f:
        value = f.read().strip()
    if not re.match(r'^[A-Za-z0-9]{32,128}$', value):
        raise HelperError(f'{path} does not hold a generated secret')
    return value


def known_secrets():
    out = []
    for path in (JWT_FILE, LINK_FILE, COOL_ADMIN_FILE):
        try:
            with open(P(path), encoding='ascii') as f:
                v = f.read().strip()
            if v:
                out.append(v)
        except OSError:
            pass
    return out


JWT_LIKE = re.compile(r'eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}')
QUERY_SECRETS = re.compile(
    r'((?:access_token|token|md5|shardkey|WOPISrc|filename|password)=)[^&\s"\']+', re.I)
BEARER = re.compile(r'(Bearer\s+)[A-Za-z0-9._~+/=-]+', re.I)


def redact(text):
    if not text:
        return text
    for s in known_secrets():
        text = text.replace(s, '[secret]')
    text = JWT_LIKE.sub('[jwt]', text)
    text = BEARER.sub(r'\1[redacted]', text)
    text = QUERY_SECRETS.sub(r'\1[redacted]', text)
    return text


