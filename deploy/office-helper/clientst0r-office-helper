def _log(msg):
    if TEST_MODE:
        return
    try:
        syslog.openlog('clientst0r-office-helper')
        syslog.syslog(syslog.LOG_NOTICE, msg)
    except Exception:
        pass


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def run(argv, timeout=120, check=False, input_text=None):
    """Run a fixed program. argv[0] is a bare name looked up in SAFE_PATH
    only; arguments are never passed through a shell."""
    try:
        r = subprocess.run(argv, env=BASE_ENV, timeout=timeout, text=True, capture_output=True,
                           stdin=subprocess.DEVNULL if input_text is None else None,
                           input=input_text)
    except FileNotFoundError:
        raise HelperError(f'{argv[0]} is not installed')
    except subprocess.TimeoutExpired:
        raise HelperError(f'{argv[0]} {argv[1] if len(argv) > 1 else ""} timed out')
    if check and r.returncode != 0:
        raise HelperError(f'{" ".join(argv[:3])} failed: {redact(r.stderr.strip())[-400:]}')
    return r


def docker(*args, timeout=120, check=False):
    return run(['docker', *args], timeout=timeout, check=check)


def compose(*args, timeout=600, check=True):
    return run(['docker', 'compose', '--project-name', PROJECT, '--file', P(COMPOSE_FILE),
                *args], timeout=timeout, check=check)


def _check_trusted(path, *, secret=False):
    """Root-owned and not writable by group/other (secrets: no group/other
    access at all)."""
    try:
        st = os.stat(path)
    except FileNotFoundError:
        raise HelperError(f'{path} is missing')
    if TEST_MODE:
        return st
    if st.st_uid != 0 or st.st_mode & (0o077 if secret else 0o022):
        raise HelperError(f'{path} must be owned by root and not writable by others'
                          + (' (and not readable by others)' if secret else ''))
    return st


def write_atomic(path, content, mode=0o600):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = os.path.join(directory, f'.tmp-{os.getpid()}-{secrets.token_hex(4)}')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def read_json(path, default=None):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return default


