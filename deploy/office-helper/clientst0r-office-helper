def docker_available():
    r = docker('version', '--format', '{{.Server.Version}}', timeout=20)
    if r.returncode != 0:
        return False, '', redact(r.stderr.strip())[:300]
    c = docker('compose', 'version', '--short', timeout=20)
    if c.returncode != 0:
        return False, r.stdout.strip(), 'Docker Compose v2 ("docker compose") is not available'
    return True, r.stdout.strip(), c.stdout.strip()


def container_state():
    r = docker('inspect', '--type', 'container', '--format', '{{json .}}', CONTAINER, timeout=30)
    if r.returncode != 0:
        return {'exists': False}
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return {'exists': True, 'state': 'unknown'}
    state = data.get('State') or {}
    labels = ((data.get('Config') or {}).get('Labels') or {})
    return {
        'exists': True,
        'state': state.get('Status', 'unknown'),
        'running': bool(state.get('Running')),
        'health': ((state.get('Health') or {}).get('Status')) or 'none',
        'started_at': state.get('StartedAt', ''),
        'restart_count': data.get('RestartCount', 0),
        'image': (data.get('Config') or {}).get('Image', ''),
        'release_label': labels.get('org.clientst0r.office.release', ''),
        'oom_killed': bool(state.get('OOMKilled')),
    }


def resources():
    r = docker('stats', '--no-stream', '--format', '{{json .}}', CONTAINER, timeout=30)
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    try:
        data = json.loads(r.stdout.strip().splitlines()[0])
    except ValueError:
        return {}
    return {'cpu_percent': data.get('CPUPerc', ''), 'memory': data.get('MemUsage', ''),
            'memory_percent': data.get('MemPerc', ''), 'pids': data.get('PIDs', '')}


def dir_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total


def healthcheck_http(conf, timeout=5):
    """GET http://127.0.0.1:<port>/healthcheck from the host; True on "true"."""
    url = f'http://127.0.0.1:{conf["bind_port"]}/healthcheck'
    if TEST_MODE and os.environ.get('CLIENTST0R_OFFICE_HELPER_TEST_HEALTH'):
        return os.environ['CLIENTST0R_OFFICE_HELPER_TEST_HEALTH'] == 'true'
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(url, timeout=timeout) as resp:
            return resp.status == 200 and resp.read(64).strip().lower() == b'true'
    except Exception:
        return False


def wait_healthy(conf, progress, timeout=HEALTH_TIMEOUT):
    deadline = time.monotonic() + (float(os.environ.get('CLIENTST0R_OFFICE_HELPER_TEST_WAIT', 0))
                                   if TEST_MODE else timeout)
    while True:
        st = container_state()
        if st.get('exists') and st.get('health') == 'healthy' and healthcheck_http(conf):
            return True
        if st.get('exists') and st.get('state') in ('exited', 'dead'):
            return False
        if time.monotonic() >= deadline:
            return False
        progress(f'waiting for the editor to report healthy (container {st.get("state", "missing")}, '
                 f'health {st.get("health", "-")})')
        time.sleep(0.05 if TEST_MODE else 5)


def prepare_for_shutdown(progress):
    """ONLYOFFICE's documented procedure before stopping Docs: disconnect
    users and save what they edited (docker exec <container>
    documentserver-prepare4shutdown)."""
    st = container_state()
    if not st.get('running'):
        progress('editor not running: nothing to prepare')
        return
    progress('asking the editor to save open documents and disconnect users '
             '(documentserver-prepare4shutdown; can take up to 5 minutes)')
    r = docker('exec', CONTAINER, 'documentserver-prepare4shutdown', timeout=SHUTDOWN_TIMEOUT)
    if r.returncode != 0:
        raise HelperError('documentserver-prepare4shutdown failed; the editor was left running. '
                          + redact(r.stderr.strip())[-300:])


def pull(r, progress):
    progress(f'downloading {r["image"]} {r["version"]} (pinned digest) before any downtime')
    docker('pull', image_ref(r), timeout=3600, check=True)
    out = docker('image', 'inspect', '--format', '{{json .RepoDigests}}', image_ref(r), timeout=30)
    try:
        digests = json.loads(out.stdout or '[]') or []
    except ValueError:
        digests = []
    if not any(d.endswith('@' + r['digest']) for d in digests):
        raise HelperError('the downloaded image does not carry the pinned digest; refusing to run it')


