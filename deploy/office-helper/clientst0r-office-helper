def op_preflight(conf, args):
    checks = []

    def add(key, status, detail):
        checks.append({'key': key, 'status': status, 'detail': detail})

    os_id = os_ver = ''
    try:
        with open(P('/etc/os-release') if TEST_MODE and os.path.exists(P('/etc/os-release'))
                  else '/etc/os-release', encoding='utf-8') as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k == 'ID':
                    os_id = v.strip('"')
                elif k == 'VERSION_ID':
                    os_ver = v.strip('"')
    except OSError:
        pass
    if (os_id, os_ver) in (('ubuntu', '24.04'), ('ubuntu', '22.04'), ('debian', '12')):
        add('os', 'pass', f'{os_id} {os_ver}')
    else:
        add('os', 'fail', f'{os_id or "unknown"} {os_ver}: supported are Ubuntu 22.04/24.04 and Debian 12')
    arch = platform.machine()
    if arch in ('x86_64', 'aarch64'):
        add('arch', 'pass' if arch == 'x86_64' else 'warn',
            arch + ('' if arch == 'x86_64' else ': the image is published for arm64; untested here'))
    else:
        add('arch', 'fail', f'{arch}: the ONLYOFFICE image is published for amd64 and arm64 only')

    ok, version, detail = docker_available()
    add('docker', 'pass' if ok else 'fail',
        f'Docker {version}, Compose {detail}' if ok else
        f'Docker is not usable: {detail}. Run scripts/office/install-editor.sh --mode managed-local '
        '(it installs Docker only when none is present and never replaces an existing one).')
    if run(['nft', '--version'], timeout=10).returncode == 0:
        add('nftables', 'pass', 'nft available (container egress is restricted with it)')
    else:
        add('nftables', 'fail', 'nft is not installed; the container firewall cannot be applied')

    mem = _meminfo()
    total, avail, swap = mem.get('MemTotal', 0), mem.get('MemAvailable', 0), mem.get('SwapTotal', 0)
    need = conf['memory_mb'] + conf['reserve_mb']
    add('memory', 'pass' if total >= need else 'fail',
        f'{total} MB RAM ({avail} MB available); the editor is limited to {conf["memory_mb"]} MB and '
        f'{conf["reserve_mb"]} MB stay for clientst0r (needs {need} MB)')
    if conf['memory_mb'] < VENDOR_RECOMMENDED_MEMORY_MB:
        add('memory_limit', 'warn', f'MEMORY_MB {conf["memory_mb"]} is under ONLYOFFICE\'s recommended '
                                    f'{VENDOR_RECOMMENDED_MEMORY_MB} MB for the Docker image')
    if swap < 2048:
        add('swap', 'warn', f'{swap} MB swap; ONLYOFFICE recommends at least 2 GB (Docker) / 4 GB (Linux)')
    ncpu = _cpu_count()
    add('cpu', 'pass' if ncpu >= VENDOR_MIN_CPUS + 1 else ('warn' if ncpu >= VENDOR_MIN_CPUS else 'fail'),
        f'{ncpu} CPU(s); the editor is limited to {conf["cpus"]}, the rest stays for clientst0r '
        '(ONLYOFFICE recommends dual-core 2 GHz or better)')
    target = P(BASE_DIR) if os.path.isdir(P(BASE_DIR)) else (P('/var/lib') if os.path.isdir(P('/var/lib')) else '/')
    st = os.statvfs(target)
    free_gb = st.f_bavail * st.f_frsize // (1024 ** 3)
    add('disk', 'fail' if free_gb < DISK_FAIL_GB else ('warn' if free_gb < DISK_WARN_GB else 'pass'),
        f'{free_gb} GB free for {BASE_DIR} (fails under {DISK_FAIL_GB} GB; ONLYOFFICE\'s Linux page '
        f'asks for {DISK_WARN_GB} GB)')

    listeners = listening_ports()
    cs = container_state()
    if conf['bind_port'] in listeners and not cs.get('running'):
        add('port', 'fail', f'127.0.0.1:{conf["bind_port"]} is already in use by another program')
    else:
        add('port', 'pass', f'port {conf["bind_port"]} is free (or used by this editor)')
    if 443 in listeners:
        add('proxy', 'pass', 'a web server listens on 443 (the container reaches clientst0r through it)')
    else:
        add('proxy', 'fail', 'nothing listens on 443: the reverse proxy for clientst0r and the office '
                             'host name must run on this VM')

    overlap = subnet_conflict(conf)
    add('subnet', 'fail' if overlap else 'pass',
        f'{conf["subnet"]} overlaps {overlap}; set NETWORK_SUBNET' if overlap else
        f'{conf["subnet"]} does not overlap a local route')
    for host, label in ((conf['office_hostname'], 'office host name'),
                        (conf['clientstor_host'], 'clientst0r host name')):
        try:
            addrs = sorted({a[4][0] for a in socket.getaddrinfo(host, 443, 0, socket.SOCK_STREAM)})
            add('dns', 'pass', f'{label} {host} resolves to {", ".join(addrs[:4])}')
        except OSError:
            add('dns', 'fail', f'{label} {host} does not resolve from this host')
    r = default_release(conf)
    add('release', 'pass' if r else 'fail',
        f'will install {r["id"]}' if r else
        'no release in the list can be installed: ' + '; '.join(
            f'{x["id"]} {release_problem(x, conf)}' for x in RELEASES if x['edition'] == conf['edition']))
    if conf['edition'] == 'enterprise' and not os.path.exists(P(LICENSE_FILE)):
        add('license', 'fail', f'Enterprise edition: put the license file at {LICENSE_FILE}')
    return {'checks': checks, 'passed': all(c['status'] != 'fail' for c in checks)}


def listening_ports():
    ports = set()
    for name in ('/proc/net/tcp', '/proc/net/tcp6'):
        path = P(name) if TEST_MODE and os.path.exists(P(name)) else name
        try:
            with open(path, encoding='ascii') as f:
                next(f, None)
                for line in f:
                    parts = line.split()
                    if len(parts) > 3 and parts[3] == '0A':
                        ports.add(int(parts[1].rsplit(':', 1)[1], 16))
        except OSError:
            continue
    return ports


def subnet_conflict(conf):
    net = ipaddress.ip_network(conf['subnet'])
    r = run(['ip', '-j', 'route', 'show', 'table', 'all'], timeout=10)
    try:
        routes = json.loads(r.stdout or '[]') if r.returncode == 0 else []
    except ValueError:
        routes = []
    for route in routes:
        dst = route.get('dst', '')
        if not dst or dst == 'default' or route.get('dev') == BRIDGE:
            continue
        try:
            other = ipaddress.ip_network(dst, strict=False)
        except ValueError:
            continue
        if other.version == 4 and other.prefixlen > 0 and other.overlaps(net):
            return f'route {dst} on {route.get("dev", "?")}'
    return ''


def op_status(conf, args):
    j = reconcile_journal()
    ok, dver, cver = docker_available()
    st = container_state() if ok else {'exists': False}
    inst = installed()
    rel = release(inst.get('release', ''))
    newer = [r for r in RELEASES if r['edition'] == conf['edition'] and rel is not None
             and version_key(r) > version_key(rel)]
    return {
        'helper_version': HELPER_VERSION,
        'config': public_config(conf),
        'docker': {'available': ok, 'version': dver, 'compose': cver if ok else '',
                   'detail': '' if ok else cver},
        'installed': {k: inst.get(k) for k in ('release', 'version', 'digest', 'edition',
                                               'installed_at', 'previous_release', 'previous_backup',
                                               'state')},
        'container': st,
        'resources': resources() if st.get('running') else {},
        'data_bytes': dir_size(P(DATA_DIR)) if os.path.isdir(P(DATA_DIR)) else 0,
        'operation': {k: j.get(k) for k in ('id', 'op', 'args', 'state', 'step', 'started_at',
                                            'finished_at', 'error', 'result')} if j else {},
        'update_available': [{'id': r['id'], 'version': r['version'],
                              'installable': not release_problem(r, conf),
                              'problem': release_problem(r, conf)} for r in newer],
        'backups': [{k: b[k] for k in ('id', 'release', 'reason', 'created_at', 'size')}
                    for b in list_backups()],
        'secrets_present': os.path.exists(P(JWT_FILE)),
    }


def op_releases(conf, args):
    return {'releases': [dict({k: r[k] for k in ('id', 'version', 'edition', 'image', 'digest',
                                                 'compat', 'tested', 'published')},
                              problem=release_problem(r, conf)) for r in RELEASES],
            'installed': installed().get('release')}


def op_logs(conf, args):
    lines = args.get('lines', 200)
    r = docker('logs', '--tail', str(lines), '--timestamps', CONTAINER, timeout=30)
    if r.returncode != 0:
        return {'log': '', 'detail': 'no container logs (is the editor installed?)'}
    text = redact((r.stdout or '') + (r.stderr or ''))
    if len(text.encode()) > MAX_LOG_BYTES:
        text = text.encode()[-MAX_LOG_BYTES:].decode('utf-8', 'ignore')
    return {'log': text, 'lines': lines}


def op_secret(conf, args):
    if not os.path.exists(P(JWT_FILE)):
