[Unit]
Description=Client St0r Auto-Update Service
After=network.target

[Service]
Type=oneshot
User=administrator
Group=administrator
WorkingDirectory=/home/administrator
ExecStart=/home/administrator/scripts/auto_update.sh
StandardOutput=append:/var/log/clientst0r/auto-update.log
StandardError=append:/var/log/clientst0r/auto-update.log

# Environment
Environment="PATH=/home/administrator/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Security
PrivateTmp=true
# No NoNewPrivileges here: this unit's job is to call sudo (gunicorn reload)
# and crontab, and that flag makes both fail. The sudoers rules in
# /etc/sudoers.d/ are what limit what it can do as root.

[Install]
WantedBy=multi-user.target
