[Unit]
Description=Client St0r Accounting Sync (QuickBooks Online / Xero)
After=network.target

[Service]
Type=oneshot
User=administrator
Group=administrator
WorkingDirectory=/home/administrator
Environment="PATH=/home/administrator/venv/bin"
EnvironmentFile=/home/administrator/.env
ExecStart=/home/administrator/venv/bin/python manage.py accounting_sync
StandardOutput=journal
StandardError=journal
