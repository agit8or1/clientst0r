#!/usr/bin/python3 -I
"""
Client St0r root helper (v3.17.597).

The ONLY thing the app user may run as root without a password:

    <app user> ALL=(root) NOPASSWD: /usr/local/sbin/clientst0r-root-helper

Before this, the app was given passwordless sudo on individual commands, and
four of them were root in disguise: `cp` of a sudoers file the app user could
rewrite, `bash /tmp/...`, `apt-get -o ... *` (apt options can run commands)
and bare `fail2ban-client` (it can set a jail's ban action). A compromised web
worker could use any of them to become root.

This helper replaces them. It runs a fixed set of actions, checks every
argument, and never executes, imports or copies anything from the app's own
directory, which the app user can write. It changes itself only from a GitHub
release tag that carries a valid signature from a key in
/etc/clientst0r/allowed_signers, and never to an older release than the one
it already runs. So neither the web app nor the repository alone can change
what runs as root; that needs the release signing key.

Usage (as root, normally via sudo from the app):
    clientst0r-root-helper version
    clientst0r-root-helper reload | restart
    clientst0r-root-helper fail2ban ping | status [JAIL] | unban JAIL IP | start | install
    clientst0r-root-helper apt update | upgrade | upgrade-packages PKG...
    clientst0r-root-helper self-update vX.Y.Z
    clientst0r-root-helper apply-system-config
    clientst0r-root-helper office-setup ENGINE LAYOUTS CLIENTSTOR_HOST DEPLOYMENT_ID OFFICE_HOST|- tested|untested
    clientst0r-root-helper office-site-include on|off

With the managed ONLYOFFICE service configured (/etc/clientst0r/office-service.conf),
`apt upgrade` and `apt upgrade-packages` leave the container engine alone, and
self-update also replaces /usr/local/sbin/clientst0r-office-helper.

office-setup runs scripts/office/install-editor.sh --mode managed-local from
the release this helper was installed from (the signed tag in its own mirror,
verified again), never from the app directory. Every argument is checked;
TLS is always `upstream` (ends on a device in front of this server) and the
app user comes from root-helper.conf. Once the office service is configured,
its clientst0r host name and deployment id can only change from a root shell.
office-site-include adds (or removes) the include line for the managed
editor's same-host snippet in clientst0r's own Nginx site, runs nginx -t and
puts the previous file back if that fails.

Files (all root-owned, none writable by the app user):
    /etc/clientst0r/root-helper.conf      APP_USER, APP_DIR, SERVICE, REPO_URL
    /etc/clientst0r/allowed_signers       ssh keys trusted to sign releases
    /var/lib/clientst0r/root-helper/      mirror of signed tags, installed version
"""
import fcntl
import ipaddress
import os
import re
import shutil
import stat
import subprocess
import sys
import syslog
import tempfile

CONF_PATH = '/etc/clientst0r/root-helper.conf'
SIGNERS_PATH = '/etc/clientst0r/allowed_signers'
STATE_DIR = '/var/lib/clientst0r/root-helper'
HELPER_PATH = '/usr/local/sbin/clientst0r-root-helper'
SUDOERS_DIR = '/etc/sudoers.d'
SYSTEMD_DIR = '/etc/systemd/system'
LOCK_PATH = '/run/clientst0r-root-helper.lock'
HELPER_REPO_PATH = 'deploy/root-helper/clientst0r-root-helper'
# Managed Local ONLYOFFICE (docs/office/MANAGED_LOCAL.md): a separate root
# service installed by scripts/office/install-editor.sh --mode managed-local.
# When it is installed, self-update replaces it from the same signed tag.
OFFICE_HELPER_PATH = '/usr/local/sbin/clientst0r-office-helper'
OFFICE_HELPER_REPO_PATH = 'deploy/office-helper/clientst0r-office-helper'
OFFICE_SERVICE_CONF = '/etc/clientst0r/office-service.conf'
OFFICE_INSTALLER_DIR = '/var/lib/clientst0r/root-helper/office-installer'
OFFICE_SNIPPET = '/etc/nginx/clientst0r-office/same-host.conf'
NGINX_DIR = '/etc/nginx'
NGINX_SITES_ENABLED = '/etc/nginx/sites-enabled'
INCLUDE_MARKER = '# clientst0r-root-helper: managed office editor (same-host)'
OWN_SUDOERS = 'clientst0r-root-helper'

# Tests turn this off so they can run against files they own.
REQUIRE_ROOT_OWNED = True

SAFE_PATH = '/usr/sbin:/usr/bin:/sbin:/bin'
BASE_ENV = {
    'PATH': SAFE_PATH,
    'HOME': '/root',
    'LANG': 'C.UTF-8',
    'GIT_CONFIG_NOSYSTEM': '1',
    'GIT_CONFIG_GLOBAL': '/dev/null',
    'GIT_TERMINAL_PROMPT': '0',
}
APT_ENV = dict(BASE_ENV, DEBIAN_FRONTEND='noninteractive',
               DEBCONF_NONINTERACTIVE_SEEN='true')
APT_OPTS = ['-y', '-o', 'Dpkg::Options::=--force-confdef',
            '-o', 'Dpkg::Options::=--force-confold']

USER_RE = re.compile(r'^[a-z_][a-z0-9_-]{0,31}$')
DIR_RE = re.compile(r'^/[A-Za-z0-9._/-]{1,200}$')
SERVICE_RE = re.compile(r'^clientst0r-[a-z0-9-]{1,40}\.service$')
REPO_RE = re.compile(r'^(https://[A-Za-z0-9.-]+/[A-Za-z0-9._/-]+|file:///[A-Za-z0-9._/-]+)$')
TAG_RE = re.compile(r'^v(\d{1,4})\.(\d{1,4})\.(\d{1,6})$')
JAIL_RE = re.compile(r'^[A-Za-z0-9_.-]{1,64}$')
HOST_RE = re.compile(r'^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$')
DEPLOYMENT_RE = re.compile(r'^[a-z0-9][a-z0-9-]{1,40}$')
OFFICE_ENGINES = ('collabora', 'onlyoffice')
OFFICE_LAYOUTS = ('same-host', 'dedicated', 'same-host,dedicated', 'dedicated,same-host')
# Debian package names, optionally with an :arch qualifier. Cannot start with
# '-', so nothing here can be read by apt-get as an option.
PKG_RE = re.compile(r'^[a-z0-9][a-z0-9+.-]{0,100}(:[a-z0-9-]{1,20})?$')
# Office editor packages (scripts/office/install-editor.sh). They are pinned
# and held there and upgraded only with `install-editor.sh --upgrade` after
# the sessions are drained, so the app's package updates never name them.
EDITOR_PKG_RE = re.compile(r'^(onlyoffice-documentserver(-ee|-de)?|coolwsd|code-brand|'
                           r'collabora-online-brand|collaboraoffice[a-z0-9+.-]*)(:[a-z0-9-]{1,20})?$')
# Container engine packages. Upgrading them restarts dockerd and with it the
# managed ONLYOFFICE container, without draining editing sessions, so while
# that service is configured the app's package updates leave them alone.
ENGINE_PKG_RE = re.compile(r'^(docker\.io|docker-ce(-cli|-rootless-extras)?|docker-compose-v2|'
                           r'docker-compose-plugin|docker-buildx(-plugin)?|containerd(\.io)?|runc)'
                           r'(:[a-z0-9-]{1,20})?$')
ENGINE_REFUSAL = ('the managed ONLYOFFICE service runs on Docker here: stop it from Office settings '
                  '(that saves open documents first), upgrade the container engine from a root '
                  'shell, then start it again')


def office_service_configured():
    return os.path.exists(OFFICE_SERVICE_CONF)


class HelperError(Exception):
    pass


# ---------------------------------------------------------------------------
# plumbing
# ---------------------------------------------------------------------------

def _log(msg):
    try:
        syslog.openlog('clientst0r-root-helper')
        syslog.syslog(syslog.LOG_NOTICE, f'{msg} (by {os.environ.get("SUDO_USER", "?")})')
    except Exception:
        pass


def _run(argv, env=None, timeout=600, capture=False):
    return subprocess.run(argv, env=env or BASE_ENV, timeout=timeout,
                          stdin=subprocess.DEVNULL, text=True,
                          capture_output=capture)


def _check_trusted_file(path):
    """A file we read for trust decisions must be root-owned and not writable
    by anyone else."""
    try:
        st = os.stat(path)
    except FileNotFoundError:
        raise HelperError(f'{path} is missing; rerun install-root-helper.sh')
    if REQUIRE_ROOT_OWNED and (st.st_uid != 0 or st.st_mode & 0o022):
        raise HelperError(f'{path} must be owned by root and not group/world writable')


def load_config():
    _check_trusted_file(CONF_PATH)
    conf = {}
    with open(CONF_PATH, encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                key, value = line.split('=', 1)
                conf[key.strip()] = value.strip()
    conf.setdefault('SERVICE', 'clientst0r-gunicorn.service')
    checks = {'APP_USER': USER_RE, 'APP_DIR': DIR_RE,
              'SERVICE': SERVICE_RE, 'REPO_URL': REPO_RE}
    for key, pattern in checks.items():
        if not pattern.match(conf.get(key, '')):
            raise HelperError(f'{CONF_PATH}: {key} is missing or invalid')
    if conf['APP_USER'] == 'root':
        raise HelperError(f'{CONF_PATH}: APP_USER must not be root')
    return conf


def _write_atomic(path, content, mode):
    directory = os.path.dirname(path)
    # A dot-prefixed temp name: sudo skips files containing '.' in
    # /etc/sudoers.d, so a half-written file is never live.
    fd, tmp = tempfile.mkstemp(prefix='.clientst0r-', dir=directory)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _version_tuple(tag):
    m = TAG_RE.match(tag or '')
    return tuple(int(x) for x in m.groups()) if m else None


# ---------------------------------------------------------------------------
# service
# ---------------------------------------------------------------------------

def cmd_reload(conf):
    if _run(['systemctl', 'reload', conf['SERVICE']]).returncode == 0:
        return 0
    return _run(['systemctl', 'restart', conf['SERVICE']]).returncode


def cmd_restart(conf):
    return _run(['systemctl', 'restart', conf['SERVICE']]).returncode


# ---------------------------------------------------------------------------
# fail2ban
# ---------------------------------------------------------------------------

def _fail2ban_client():
    for path in ('/usr/bin/fail2ban-client', '/usr/local/bin/fail2ban-client'):
        if os.path.isfile(path):
            st = os.stat(path)
            if st.st_uid == 0 and not st.st_mode & 0o022:
                return path
    raise HelperError('fail2ban-client not found (or not root-owned)')


def fail2ban_argv(args):
    """Map an allowed fail2ban action to the fail2ban-client argv."""
    if args == ['ping']:
        return ['ping']
    if args == ['start']:
        return ['start']
    if args == ['status']:
        return ['status']
    if len(args) == 2 and args[0] == 'status' and JAIL_RE.match(args[1]):
        return ['status', args[1]]
    if len(args) == 3 and args[0] == 'unban' and JAIL_RE.match(args[1]):
        try:
            ip = str(ipaddress.ip_address(args[2]))
        except ValueError:
            raise HelperError(f'not an IP address: {args[2]!r}')
        return ['set', args[1], 'unbanip', ip]
    raise HelperError('usage: fail2ban ping | status [JAIL] | unban JAIL IP | start | install')


def cmd_fail2ban(args):
    if args == ['install']:
        for argv in (['apt-get', '-q', 'update'],
                     ['apt-get', *APT_OPTS, 'install', 'fail2ban'],
                     ['systemctl', 'enable', '--now', 'fail2ban']):
            rc = _run(argv, env=APT_ENV).returncode
            if rc != 0:
                return rc
        return 0
    return _run([_fail2ban_client(), *fail2ban_argv(args)], timeout=30).returncode


# ---------------------------------------------------------------------------
# apt
# ---------------------------------------------------------------------------

def apt_argv(args):
    if args == ['update']:
        return ['apt-get', '-q', 'update']
    if args == ['upgrade']:
        return ['apt-get', *APT_OPTS, 'upgrade']
    if len(args) >= 2 and args[0] == 'upgrade-packages':
        packages = args[1:]
        if len(packages) > 500:
            raise HelperError('too many packages')
        bad = [p for p in packages if not PKG_RE.match(p)]
        if bad:
            raise HelperError(f'invalid package name(s): {bad[:5]}')
        editor = [p for p in packages if EDITOR_PKG_RE.match(p)]
        if editor:
            raise HelperError(f'refusing to upgrade Office editor package(s) {editor[:5]}: '
                              'use scripts/office/install-editor.sh --upgrade after draining sessions')
        engine = [p for p in packages if ENGINE_PKG_RE.match(p)]
        if engine and office_service_configured():
            raise HelperError(f'refusing to upgrade {engine[:5]}: {ENGINE_REFUSAL}')
        return ['apt-get', *APT_OPTS, 'install', '--only-upgrade', *packages]
    raise HelperError('usage: apt update | upgrade | upgrade-packages PKG...')


INST_RE = re.compile(r'^Inst ([a-z0-9][a-z0-9+.-]{0,100}(:[a-z0-9-]{1,20})?) ')


def held_back_upgrade_argv(simulation):
    """`apt upgrade` while the managed ONLYOFFICE service is configured:
    every package a plain upgrade would upgrade (from `apt-get -s upgrade`),
    except the container engine and the editor packages. Returns
    (argv or None, skipped)."""
    names, skipped = [], []
    for line in simulation.splitlines():
        m = INST_RE.match(line)
        if not m:
            continue
        name = m.group(1)
        (skipped if ENGINE_PKG_RE.match(name) or EDITOR_PKG_RE.match(name) else names).append(name)
    if not names:
        return None, skipped
    return ['apt-get', *APT_OPTS, 'install', '--only-upgrade', *names], skipped


def cmd_apt(args):
    if args == ['upgrade'] and office_service_configured():
        sim = _run(['apt-get', '-s', '-q', 'upgrade'], env=APT_ENV, timeout=600, capture=True)
        if sim.returncode != 0:
            raise HelperError('apt-get -s upgrade failed: ' + (sim.stderr or '').strip()[:300])
        argv, skipped = held_back_upgrade_argv(sim.stdout)
        if skipped:
            print(f'Not upgrading {" ".join(skipped)}: {ENGINE_REFUSAL}')
        if argv is None:
            print('nothing else to upgrade')
            return 0
        return _run(argv, env=APT_ENV, timeout=1800).returncode
    return _run(apt_argv(args), env=APT_ENV, timeout=1800).returncode


# ---------------------------------------------------------------------------
# self-update from a signed release tag
# ---------------------------------------------------------------------------

def _git(mirror, *args, timeout=120):
    return _run(['git', '-C', mirror, *args], timeout=timeout, capture=True)


def installed_version():
    try:
        with open(os.path.join(STATE_DIR, 'installed-version'), encoding='utf-8') as f:
            return f.read().strip()
    except FileNotFoundError:
        return ''


def _verify_tag(mirror, tag):
    r = _git(mirror, '-c', 'gpg.format=ssh',
             '-c', f'gpg.ssh.allowedSignersFile={SIGNERS_PATH}',
             'verify-tag', tag)
    if r.returncode != 0:
        raise HelperError(f'{tag} is not signed by a trusted release key; not installing')

    # The signature covers the tag object, not the ref we fetched it by. Without
    # this check, a ref named v9.9.9 could point at an older signed tag object
    # and replay an old helper under a newer version number.
    r = _git(mirror, 'cat-file', 'tag', tag)
    if r.returncode != 0 or f'\ntag {tag}\n' not in '\n' + r.stdout:
        raise HelperError(f'{tag}: the signed tag object is not named {tag}')


def self_update(conf, tag):
    if not TAG_RE.match(tag):
        raise HelperError(f'not a release tag: {tag!r}')
    _check_trusted_file(SIGNERS_PATH)

    current = installed_version()
    if _version_tuple(current) and _version_tuple(tag) < _version_tuple(current):
        raise HelperError(f'refusing to downgrade from {current} to {tag}')

    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    mirror = os.path.join(STATE_DIR, 'mirror.git')
    if not os.path.isdir(mirror):
        r = _run(['git', 'init', '-q', '--bare', mirror], capture=True)
        if r.returncode != 0:
            raise HelperError(f'git init failed: {r.stderr.strip()}')

    r = _git(mirror, 'fetch', '-q', '--no-tags', '--force', conf['REPO_URL'],
             f'refs/tags/{tag}:refs/tags/{tag}', timeout=300)
    if r.returncode != 0:
        raise HelperError(f'could not fetch {tag}: {r.stderr.strip()[:300]}')

    _verify_tag(mirror, tag)

    r = _git(mirror, 'cat-file', 'blob', f'{tag}:{HELPER_REPO_PATH}')
    if r.returncode != 0:
        raise HelperError(f'{tag} has no {HELPER_REPO_PATH}')
    source = r.stdout
    compile(source, HELPER_REPO_PATH, 'exec')   # refuse anything that won't even parse

    try:
        with open(HELPER_PATH, encoding='utf-8') as f:
            changed = f.read() != source
    except FileNotFoundError:
        changed = True
    if changed:
        _write_atomic(HELPER_PATH, source, 0o755)
    office_note = _update_office_helper(mirror, tag)
    _write_atomic(os.path.join(STATE_DIR, 'installed-version'), tag + '\n', 0o644)
    _log(f'self-update to {tag} ({"replaced" if changed else "unchanged"}){office_note}')
    print(f'root helper {"updated" if changed else "already current"} at {tag}{office_note}')
    return 0


def _update_office_helper(mirror, tag):
    """Replace the Office service helper from the same verified tag, only
    where install-editor.sh --mode managed-local installed it. It is socket
    activated per connection, so the next request runs the new copy and an
    operation already running finishes on the old one."""
    if not os.path.exists(OFFICE_HELPER_PATH):
        return ''
    r = _git(mirror, 'cat-file', 'blob', f'{tag}:{OFFICE_HELPER_REPO_PATH}')
    if r.returncode != 0:
        return '; office helper: not in this release, left as it is'
    source = r.stdout
    compile(source, OFFICE_HELPER_REPO_PATH, 'exec')
    with open(OFFICE_HELPER_PATH, encoding='utf-8') as f:
        if f.read() == source:
            return '; office helper unchanged'
    _write_atomic(OFFICE_HELPER_PATH, source, 0o755)
    return '; office helper updated'


# ---------------------------------------------------------------------------
# managed office editor: host setup and clientst0r's Nginx include
# ---------------------------------------------------------------------------

def _office_conf():
    conf = {}
    try:
        with open(OFFICE_SERVICE_CONF, encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    key, value = line.split('=', 1)
                    conf[key.strip()] = value.strip()
    except FileNotFoundError:
        return None
    return conf


def office_setup_argv(conf, args, script):
    """The installer command line for `office-setup`, from checked arguments only."""
    if len(args) != 6:
        raise HelperError('office-setup ENGINE LAYOUTS CLIENTSTOR_HOST DEPLOYMENT_ID OFFICE_HOST|- tested|untested')
    engine, layouts, app_host, deployment, office_host, tested = args
    if engine not in OFFICE_ENGINES:
        raise HelperError(f'unknown office engine: {engine!r}')
    if layouts not in OFFICE_LAYOUTS:
        raise HelperError(f'unknown layouts: {layouts!r}')
    if engine == 'onlyoffice' and layouts != 'dedicated':
        raise HelperError('ONLYOFFICE runs only on a dedicated host name')
    if not HOST_RE.match(app_host):
        raise HelperError(f'not a host name: {app_host!r}')
    if not DEPLOYMENT_RE.match(deployment):
        raise HelperError(f'not a deployment id: {deployment!r}')
    if 'dedicated' in layouts.split(','):
        if not HOST_RE.match(office_host) or office_host == app_host:
            raise HelperError('the dedicated layout needs its own office host name')
    elif office_host != '-':
        raise HelperError('an office host name is only used with the dedicated layout')
    if tested not in ('tested', 'untested'):
        raise HelperError('last argument must be tested or untested')
    existing = _office_conf()
    if existing is not None:
        # The app may extend an install, never point it somewhere else.
        old_host = re.sub(r'^https://|/$', '', existing.get('CLIENTSTOR_URL', ''))
        if old_host != app_host or existing.get('DEPLOYMENT_ID', '') != deployment:
            raise HelperError('the office service is already set up for another clientst0r host or '
                              'deployment id; change that from a root shell')
    argv = ['/bin/bash', script, '--provider', engine, '--mode', 'managed-local',
            '--layouts', layouts, '--clientstor-url', f'https://{app_host}/',
            '--deployment-id', deployment, '--tls', 'upstream',
            '--app-user', conf['APP_USER'], '--install-docker']
    if office_host != '-':
        argv += ['--hostname', office_host]
    if tested == 'untested':
        argv.append('--allow-untested-releases')
    return argv


def _extract_office_installer(tag):
    """scripts/office + deploy/office-helper from the verified tag, into a
    fresh root-only directory."""
    mirror = os.path.join(STATE_DIR, 'mirror.git')
    if not TAG_RE.match(tag or '') or not os.path.isdir(mirror):
        raise HelperError('the root helper has no verified release to install the office service from; '
                          'run an update first')
    _check_trusted_file(SIGNERS_PATH)
    _verify_tag(mirror, tag)
    shutil.rmtree(OFFICE_INSTALLER_DIR, ignore_errors=True)
    os.makedirs(OFFICE_INSTALLER_DIR, mode=0o700)
    archive = os.path.join(OFFICE_INSTALLER_DIR, 'release.tar')
    r = _git(mirror, 'archive', '--format=tar', '-o', archive, tag, 'scripts/office', 'deploy/office-helper')
    if r.returncode != 0:
        raise HelperError(f'{tag} has no office installer: {r.stderr.strip()[:300]}')
    r = _run(['tar', '-x', '--no-same-owner', '-f', archive, '-C', OFFICE_INSTALLER_DIR], capture=True)
    os.unlink(archive)
    if r.returncode != 0:
        raise HelperError(f'could not unpack the office installer: {r.stderr.strip()[:300]}')
    script = os.path.join(OFFICE_INSTALLER_DIR, 'scripts', 'office', 'install-editor.sh')
    if not os.path.isfile(script):
        raise HelperError(f'{tag} has no scripts/office/install-editor.sh')
    return script


def cmd_office_setup(conf, args):
    office_setup_argv(conf, args, '-')          # refuse bad arguments before touching anything
    tag = installed_version()
    script = _extract_office_installer(tag)
    argv = office_setup_argv(conf, args, script)
    print(f'office-setup from {tag}', flush=True)
    return _run(argv, env=APT_ENV, timeout=2400).returncode


def app_site(conf):
    """The one enabled Nginx site that serves clientst0r (it names APP_DIR)."""
    marker = conf['APP_DIR'].rstrip('/') + '/'
    found = []
    try:
        names = sorted(os.listdir(NGINX_SITES_ENABLED))
    except FileNotFoundError:
        raise HelperError(f'{NGINX_SITES_ENABLED} is missing')
    for name in names:
        real = os.path.realpath(os.path.join(NGINX_SITES_ENABLED, name))
        if not real.startswith(NGINX_DIR.rstrip('/') + '/') or not os.path.isfile(real):
            continue
        with open(real, encoding='utf-8') as f:
            text = f.read()
        if INCLUDE_MARKER in text or any(marker in line and not line.lstrip().startswith('#')
                                         for line in text.splitlines()):
            found.append(real)
    if len(found) != 1:
        raise HelperError(f'expected one enabled Nginx site for clientst0r, found {len(found)}; '
                          'add the include line by hand')
    return found[0]


LOCATION_ROOT_RE = re.compile(r'^(\s*)location\s+/\s*\{')


def site_with_include(text, on):
    """`text` with the include line before every active `location / {`
    (on), or with the lines this helper added removed (off)."""
    lines = [l for l in text.splitlines(keepends=True) if INCLUDE_MARKER not in l]
    if not on:
        return ''.join(lines)
    out, added = [], 0
    for line in lines:
        m = LOCATION_ROOT_RE.match(line)
        if m:
            out.append(f'{m.group(1)}include {OFFICE_SNIPPET};  {INCLUDE_MARKER}\n')
            added += 1
        out.append(line)
    if not added:
        raise HelperError('no `location / {` block in the clientst0r site; add the include line by hand')
    return ''.join(out)


def cmd_office_site_include(conf, args):
    if args not in (['on'], ['off']):
        raise HelperError('office-site-include on|off')
    on = args == ['on']
    if on and not os.path.isfile(OFFICE_SNIPPET):
        raise HelperError(f'{OFFICE_SNIPPET} is missing; set up the office service first')
    path = app_site(conf)
    with open(path, encoding='utf-8') as f:
        before = f.read()
    after = site_with_include(before, on)
    if after == before:
        print(f'{path}: already {"included" if on else "removed"}')
        return 0
    mode = stat.S_IMODE(os.stat(path).st_mode)
    _write_atomic(path, after, mode)
    r = _run(['nginx', '-t'], capture=True, timeout=60)
    if r.returncode != 0:
        _write_atomic(path, before, mode)
        raise HelperError(f'nginx -t rejected the change; {path} was put back: {r.stderr.strip()[-300:]}')
    r = _run(['systemctl', 'reload', 'nginx'], timeout=60)
    if r.returncode != 0:
        _write_atomic(path, before, mode)
        _run(['systemctl', 'reload', 'nginx'], timeout=60)
        raise HelperError(f'nginx did not reload; {path} was put back')
    print(f'{path}: include {"added" if on else "removed"}; nginx reloaded')
    return 0


