# A NOPASSWD rule matching any of these is a way to root and gets commented
# out wherever it appears in /etc/sudoers.d/clientst0r-*.
UNSAFE_RULES = [
    (re.compile(r'NOPASSWD:.*\s/(usr/)?bin/(cp|mv|tee|install|chmod|chown)\s'), 'writes files as root'),
    (re.compile(r'NOPASSWD:.*\s/tmp/'), 'runs a file from /tmp'),
    (re.compile(r'NOPASSWD:.*\s/home/'), 'runs a program from a home directory'),
    (re.compile(r'NOPASSWD:.*\*\s*$'), 'accepts arbitrary trailing arguments'),
    (re.compile(r'NOPASSWD:\s*\S*fail2ban-client\s*$'), 'unrestricted fail2ban-client'),
    (re.compile(r'NOPASSWD:.*\s\S*/(bash|sh|python3?|pip3?|systemd-run)\s*(,|$)'), 'unrestricted interpreter'),
]
DISABLED_PREFIX = '# disabled by clientst0r-root-helper (unsafe: {}): '


def neutralize_sudoers(text):
    """Return (new_text, reasons) with every unsafe rule commented out."""
    out, reasons = [], []
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped and not stripped.startswith('#'):
            for pattern, why in UNSAFE_RULES:
                if pattern.search(stripped):
                    line = DISABLED_PREFIX.format(why) + line
                    reasons.append(f'{why}: {stripped}')
                    break
        out.append(line)
    return ''.join(out), reasons


def own_sudoers_rule(conf):
    return (
        '# Managed by clientst0r-root-helper. The app runs root actions only\n'
        '# through this program, which checks every argument.\n'
        f'{conf["APP_USER"]} ALL=(root) NOPASSWD: {HELPER_PATH}\n'
    )


def render_auto_update_unit(conf):
    d, u = conf['APP_DIR'], conf['APP_USER']
    return f"""[Unit]
Description=Client St0r Auto-Update Service
After=network.target

[Service]
Type=oneshot
User={u}
Group={u}
WorkingDirectory={d}
ExecStart={d}/scripts/auto_update.sh
StandardOutput=append:/var/log/clientst0r/auto-update.log
StandardError=append:/var/log/clientst0r/auto-update.log
Environment="PATH={d}/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Security
PrivateTmp=true
# No NoNewPrivileges: this unit must be able to call sudo for the root helper.
# Written by clientst0r-root-helper apply-system-config.

[Install]
WantedBy=multi-user.target
"""


def _visudo_ok(path):
    return _run(['visudo', '-c', '-q', '-f', path], capture=True).returncode == 0


def _install_sudoers(path, content):
    fd, tmp = tempfile.mkstemp(prefix='.clientst0r-', dir=SUDOERS_DIR)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(content)
        os.chmod(tmp, 0o440)
        if not _visudo_ok(tmp):
            raise HelperError(f'refusing to write {path}: visudo rejected it')
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def apply_system_config(conf):
    changes = []

    own = os.path.join(SUDOERS_DIR, OWN_SUDOERS)
    wanted = own_sudoers_rule(conf)
    try:
        with open(own, encoding='utf-8') as f:
            current = f.read()
    except FileNotFoundError:
        current = None
    if current != wanted:
        _install_sudoers(own, wanted)
        changes.append(f'wrote {own}')

    for name in sorted(os.listdir(SUDOERS_DIR)):
        if not name.startswith('clientst0r-') or '.' in name or name == OWN_SUDOERS:
            continue
        path = os.path.join(SUDOERS_DIR, name)
        with open(path, encoding='utf-8') as f:
            text = f.read()
        new_text, reasons = neutralize_sudoers(text)
        if reasons:
            # Keep the original outside /etc/sudoers.d, in our root-only state dir.
            backup_dir = os.path.join(STATE_DIR, 'sudoers-backup')
            os.makedirs(backup_dir, mode=0o700, exist_ok=True)
            backup = os.path.join(backup_dir, name)
            if not os.path.exists(backup):
                _write_atomic(backup, text, 0o400)
            _install_sudoers(path, new_text)
            changes.extend(f'{name}: disabled rule that {r}' for r in reasons)

    unit = os.path.join(SYSTEMD_DIR, 'clientst0r-auto-update.service')
    if os.path.exists(unit):
        with open(unit, encoding='utf-8') as f:
            current = f.read()
        wanted = render_auto_update_unit(conf)
        if current != wanted:
            _write_atomic(unit, wanted, 0o644)
            _run(['systemctl', 'daemon-reload'])
            changes.append(f'rewrote {unit}')

    for line in changes:
        print(line)
        _log(f'apply-system-config: {line}')
    if not changes:
        print('system config already current')
    return 0


