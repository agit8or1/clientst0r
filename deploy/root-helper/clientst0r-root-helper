def main(argv):
    if not argv:
        print(__doc__.split('Usage', 1)[1].split('Files', 1)[0], file=sys.stderr)
        return 2
    if REQUIRE_ROOT_OWNED and os.geteuid() != 0:
        print('clientst0r-root-helper must run as root (via sudo)', file=sys.stderr)
        return 2

    command, args = argv[0], argv[1:]
    try:
        if command == 'version':
            print(installed_version() or 'unversioned (installed by install-root-helper.sh)')
            return 0
        conf = load_config()
        os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True)
        with open(LOCK_PATH, 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            _log(f'{command} {" ".join(args)}'.strip())
            if command == 'reload' and not args:
                return cmd_reload(conf)
            if command == 'restart' and not args:
                return cmd_restart(conf)
            if command == 'fail2ban':
                return cmd_fail2ban(args)
            if command == 'apt':
                return cmd_apt(args)
            if command == 'self-update' and len(args) == 1:
                return self_update(conf, args[0])
            if command == 'apply-system-config' and not args:
                return apply_system_config(conf)
            if command == 'office-setup':
                return cmd_office_setup(conf, args)
            if command == 'office-site-include':
                return cmd_office_site_include(conf, args)
        raise HelperError(f'unknown command: {command}')
    except HelperError as exc:
        print(f'clientst0r-root-helper: {exc}', file=sys.stderr)
        _log(f'refused: {exc}')
        return 1
    except subprocess.TimeoutExpired as exc:
        print(f'clientst0r-root-helper: timed out: {exc.cmd[0]}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
